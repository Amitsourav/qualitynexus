---
import Icon from "./Icon.astro";

interface Props {
  heading?: string;
  body?: string;
  ctaLabel?: string;
  ctaHref?: string;
  secondaryLabel?: string;
  secondaryHref?: string;
}

const {
  heading = "Ready to start your certification journey?",
  body = "Tell us your standard and timeline. We'll come back with a plan within 48 hours.",
  ctaLabel = "Book a free consultation",
  ctaHref = "/contact",
  secondaryLabel,
  secondaryHref = "/contact",
} = Astro.props;
---
<section class="cta-strip">
  <div class="container cta-inner">
    <div>
      <h2>{heading}</h2>
      <p>{body}</p>
    </div>
    <div class="cta-actions">
      <a href={ctaHref} class="btn btn-accent cta-btn">{ctaLabel} <Icon name="arrow-right" /></a>
      {secondaryLabel && (
        <a href={secondaryHref} class="btn cta-btn cta-btn--ghost">{secondaryLabel}</a>
      )}
    </div>
  </div>
</section>

<style>
  .cta-strip {
    position: relative;
    color: #fff;
    padding: 88px 0;
    overflow: hidden;
    isolation: isolate;
    background-color: var(--color-primary);
  }
  .cta-strip::before {
    content: "";
    position: absolute;
    inset: 0;
    background-image: url("/images/office-modern.jpg");
    background-size: cover;
    background-position: center;
    opacity: 0.20;
    z-index: -2;
    transform: scale(1.05);
    filter: saturate(0.7);
  }
  .cta-strip::after {
    content: "";
    position: absolute;
    inset: 0;
    background:
      radial-gradient(60% 60% at 30% 50%, rgba(16,185,129,0.18), transparent 70%),
      linear-gradient(135deg, rgba(14,59,46,0.92) 0%, rgba(31,85,56,0.85) 100%);
    z-index: -1;
  }
  .cta-inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 32px;
    flex-wrap: wrap;
  }
  .cta-strip h2 { color: #fff; max-width: 640px; }
  .cta-strip p { color: #94A3B8; max-width: 640px; margin-top: 10px; font-size: 16px; }
  .cta-actions {
    display: flex;
    gap: 12px;
    flex-wrap: wrap;
  }
  .cta-btn { padding: 16px 30px; font-size: 15px; }
  .cta-btn--ghost {
    background: transparent;
    color: #fff;
    border: 1px solid rgba(255,255,255,0.35);
  }
  .cta-btn--ghost:hover {
    background: rgba(255,255,255,0.08);
    border-color: rgba(255,255,255,0.55);
    color: #fff;
  }

  @media (max-width: 640px) {
    .cta-inner { flex-direction: column; align-items: flex-start; }
  }
</style>
