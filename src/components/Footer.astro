---
const year = new Date().getFullYear();
const exploreLinks = [
  { href: "/", label: "Home" },
  { href: "/about", label: "About" },
  { href: "/services", label: "Services" },
  { href: "/certifications", label: "Certifications" },
  { href: "/clients", label: "Clients" },
  { href: "/contact", label: "Contact" },
];
const popularStandards = [
  "ISO 9001",
  "ISO 14001",
  "ISO 45001",
  "ISO 27001",
  "ISO 13485",
  "ISO 22000",
];
---
<footer class="site-footer">
  <div class="container">
    <div class="footer-grid">
      <div class="footer-brand">
        <a href="/" class="brand">
          <img src="/logo-256.png" class="brand-mark" alt="" width="40" height="40" />
          <span class="brand-name">QualityNexus</span>
        </a>
        <p>Trusted partner for ISO Certification, NABL &amp; NABH Accreditation, audits, training, and business support — delivered across India.</p>
        <address class="footer-address">
          Trade Centre, 1st Floor, Main Road, SSVM School,<br/>
          Ormanjhi, Ranchi 835219, Jharkhand, India
        </address>
        <p class="contact-line">
          <a href="mailto:Qualitynexusofficial@gmail.com">Qualitynexusofficial@gmail.com</a>
        </p>
        <p class="contact-line">
          <a href="tel:+919798082076">+91 97980 82076</a>
          <span aria-hidden="true">·</span>
          <a href="tel:+917717762084">+91 77177 62084</a>
        </p>
        <ul class="footer-ids" aria-label="Statutory identifiers">
          <li><span>CIN</span><strong>U70200JH2025PTC024534</strong></li>
          <li><span>GSTIN</span><strong>20AABCQ1018L1ZW</strong></li>
          <li><span>UDYAM</span><strong>UDYAM-JH-20-0101391</strong></li>
        </ul>
      </div>

      <div class="footer-col">
        <h4>Explore</h4>
        <ul>
          {exploreLinks.map((l) => (
            <li><a href={l.href}>{l.label}</a></li>
          ))}
        </ul>
      </div>

      <div class="footer-col">
        <h4>Popular standards</h4>
        <ul>
          {popularStandards.map((s) => (
            <li><a href={`/certifications/${s.toLowerCase().replace(/\s+/g, "-")}`}>{s}</a></li>
          ))}
        </ul>
      </div>

      <div class="footer-col">
        <h4>Talk to us</h4>
        <p>Tell us about your standard, your timeline, and the gaps you already know about. We'll come back with a plan within 48 hours.</p>
        <a href="/contact" class="btn btn-accent footer-cta">Start a conversation</a>
      </div>
    </div>

    <div class="footer-credentials">
      <span class="footer-credentials-label">Registered &amp; recognized:</span>
      <span class="cred-chip">MSME</span>
      <span class="cred-chip">DIPP — Govt. of India</span>
      <span class="cred-chip">GST</span>
      <span class="cred-chip">MCA Incorporated</span>
    </div>

    <div class="footer-bottom">
      <span>© {year} QualityNexus. All rights reserved.</span>
      <span class="meta">Built lightweight on Astro · Self-hosted fonts · Static delivery</span>
    </div>
  </div>
</footer>

<style>
  .site-footer {
    background: var(--color-primary);
    color: #CBD5E1;
    padding: 88px 0 28px;
    margin-top: 0;
  }
  .footer-grid {
    display: grid;
    grid-template-columns: 1.5fr 1fr 1fr 1.4fr;
    gap: 56px;
    padding-bottom: 56px;
    border-bottom: 1px solid rgba(255, 255, 255, 0.08);
  }
  .footer-brand .brand {
    color: #fff;
    font-size: 18px;
    font-weight: 800;
    display: inline-flex;
    align-items: center;
    gap: 10px;
    margin-bottom: 18px;
  }
  .footer-brand .brand-mark {
    width: 40px;
    height: 40px;
    border-radius: 10px;
    object-fit: cover;
    display: block;
  }
  .footer-brand p {
    color: #94A3B8;
    font-size: 15px;
    max-width: 360px;
    margin-bottom: 14px;
  }
  .contact-line {
    display: flex;
    gap: 10px;
    flex-wrap: wrap;
    color: #CBD5E1;
    font-size: 14px;
  }
  .footer-address {
    color: #CBD5E1;
    font-size: 14px;
    line-height: 1.55;
    font-style: normal;
    margin-bottom: 14px;
    max-width: 320px;
  }
  .footer-ids {
    margin-top: 16px;
    display: grid;
    gap: 4px;
    list-style: none;
    padding: 0;
    border-top: 1px solid rgba(255, 255, 255, 0.08);
    padding-top: 12px;
  }
  .footer-ids li {
    display: grid;
    grid-template-columns: 64px 1fr;
    gap: 10px;
    font-size: 12px;
    align-items: baseline;
  }
  .footer-ids li span {
    color: #64748B;
    font-weight: 700;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }
  .footer-ids li strong {
    color: #CBD5E1;
    font-weight: 600;
    font-family: var(--font-heading);
    letter-spacing: -0.01em;
  }

  .footer-col h4 {
    color: #fff;
    font-size: 13px;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.1em;
    margin-bottom: 18px;
  }
  .footer-col ul { display: grid; gap: 10px; }
  .footer-col a {
    color: #94A3B8;
    font-size: 14px;
    transition: color .15s ease;
  }
  .footer-col a:hover { color: #fff; }
  .footer-col p {
    color: #94A3B8;
    font-size: 14px;
    margin-bottom: 18px;
  }
  .footer-cta {
    padding: 10px 18px;
    font-size: 14px;
  }

  .footer-credentials {
    display: flex;
    align-items: center;
    flex-wrap: wrap;
    gap: 10px;
    padding: 24px 0;
    border-bottom: 1px solid rgba(255, 255, 255, 0.06);
  }
  .footer-credentials-label {
    color: #94A3B8;
    font-size: 12px;
    font-weight: 600;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    margin-right: 6px;
  }
  .cred-chip {
    display: inline-flex;
    align-items: center;
    padding: 5px 12px;
    border: 1px solid rgba(255, 255, 255, 0.14);
    border-radius: 999px;
    color: #CBD5E1;
    font-size: 12px;
    font-weight: 600;
    letter-spacing: 0.02em;
    background: rgba(255, 255, 255, 0.04);
  }
  .footer-bottom {
    display: flex;
    justify-content: space-between;
    align-items: center;
    flex-wrap: wrap;
    gap: 12px;
    padding-top: 24px;
    color: #64748B;
    font-size: 13px;
  }
  .footer-bottom .meta { color: #475569; }

  @media (max-width: 900px) {
    .footer-grid {
      grid-template-columns: 1fr 1fr;
      gap: 40px;
    }
  }
  @media (max-width: 560px) {
    .site-footer { padding: 56px 0 24px; }
    .footer-grid { grid-template-columns: 1fr; gap: 36px; }
  }
</style>
