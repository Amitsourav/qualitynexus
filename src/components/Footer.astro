---
const year = new Date().getFullYear();

const quickLinks = [
  { href: "/",                          label: "Home" },
  { href: "/about",                     label: "About" },
  { href: "/team",                      label: "Our Team" },
  { href: "/services",                  label: "Services" },
  { href: "/certifications",            label: "Certifications" },
  { href: "/clients",                   label: "Clients" },
  { href: "/blog",                      label: "Blog" },
  { href: "/iso-consultant-ranchi",     label: "ISO Consultant in Ranchi" },
  { href: "/psu-vendor-compliance",     label: "PSU Vendor Compliance" },
  { href: "/iso-27001-consultant-india", label: "ISO 27001 Consultant India" },
  { href: "/contact",                   label: "Contact" },
];

const serviceLinks = [
  { href: "/iso-9001-consultancy",   label: "ISO 9001 Consultancy" },
  { href: "/iso-27001-consultancy",  label: "ISO 27001 Consultancy" },
  { href: "/nabl-consultancy",       label: "NABL Consultancy" },
  { href: "/vapt-services",          label: "VAPT Services" },
  { href: "/health-safety-audit",    label: "Health & Safety Audit" },
  { href: "/services",               label: "All services →" },
];

// Social URLs - drop the user's real profile links here when ready
const socials = [
  { name: "LinkedIn",  href: "#", icon: "linkedin" },
  { name: "Facebook",  href: "#", icon: "facebook" },
  { name: "Instagram", href: "#", icon: "instagram" },
  { name: "X",         href: "#", icon: "x" },
];

const trustBadges = [
  { label: "MCA Incorporated",      sub: "Pvt. Ltd. · Ministry of Corporate Affairs", id: "CIN · U70200JH2025PTC024534" },
  { label: "MSME · Udyam Registered", sub: "Ministry of MSME, Govt. of India",          id: "UDYAM-JH-20-0101391" },
  { label: "Startup India",         sub: "DPIIT-recognized startup",                  id: "Govt. of India" },
  { label: "GST Compliant",         sub: "Active GST registration",                   id: "GSTIN · 20AABCQ1018L1ZW" },
];
---
<footer class="site-footer">
  <div class="container">
    <div class="footer-grid">
      <div class="footer-brand">
        <a href="/" class="brand">
          <img src="/logo-256.png" class="brand-mark" alt="" width="40" height="40" />
          <span class="brand-name">QualityNexus</span>
        </a>
        <p>ISO certification, NABL implementation, IT security audits, and compliance consulting - across India.</p>
        <address class="footer-address">
          Trade Centre, 1st Floor, Main Road, SSVM School,<br/>
          Ormanjhi, Ranchi 835219, Jharkhand, India
        </address>
        <ul class="footer-socials" aria-label="Social media">
          {socials.map((s) => (
            <li>
              <a href={s.href} aria-label={s.name} class="footer-social">
                {s.icon === "linkedin" && (
                  <svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
                    <path d="M20.45 20.45h-3.55v-5.57c0-1.33-.03-3.04-1.85-3.04-1.86 0-2.14 1.45-2.14 2.95v5.66H9.36V9h3.41v1.56h.05c.47-.9 1.63-1.85 3.36-1.85 3.59 0 4.27 2.36 4.27 5.44v6.3zM5.34 7.43a2.06 2.06 0 1 1 0-4.13 2.06 2.06 0 0 1 0 4.13zM7.12 20.45H3.56V9h3.56v11.45z"/>
                  </svg>
                )}
                {s.icon === "facebook" && (
                  <svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
                    <path d="M22 12a10 10 0 1 0-11.56 9.88v-6.99H7.9V12h2.54V9.8c0-2.51 1.49-3.89 3.78-3.89 1.09 0 2.24.19 2.24.19v2.46h-1.26c-1.24 0-1.63.77-1.63 1.56V12h2.77l-.44 2.89h-2.33v6.99A10 10 0 0 0 22 12z"/>
                  </svg>
                )}
                {s.icon === "instagram" && (
                  <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                    <rect x="3" y="3" width="18" height="18" rx="5"/>
                    <circle cx="12" cy="12" r="4"/>
                    <circle cx="17.5" cy="6.5" r="0.9" fill="currentColor"/>
                  </svg>
                )}
                {s.icon === "x" && (
                  <svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
                    <path d="M18.244 2.25h3.308l-7.227 8.26 8.502 11.24h-6.66l-5.214-6.817L4.99 21.75H1.68l7.73-8.835L1.254 2.25h6.829l4.713 6.231 5.448-6.231zm-1.161 17.52h1.833L7.084 4.126H5.117l11.966 15.644z"/>
                  </svg>
                )}
              </a>
            </li>
          ))}
        </ul>
      </div>

      <div class="footer-col">
        <h4>Quick Links</h4>
        <ul>
          {quickLinks.map((l) => (
            <li><a href={l.href}>{l.label}</a></li>
          ))}
        </ul>
      </div>

      <div class="footer-col">
        <h4>Services</h4>
        <ul>
          {serviceLinks.map((l) => (
            <li><a href={l.href}>{l.label}</a></li>
          ))}
        </ul>
      </div>

      <div class="footer-col footer-col--contact">
        <h4>Contact</h4>
        <ul class="footer-contact">
          <li>
            <span class="footer-contact-label">Email</span>
            <a href="mailto:Qualitynexusofficial@gmail.com">Qualitynexusofficial@gmail.com</a>
          </li>
          <li>
            <span class="footer-contact-label">Phone</span>
            <a href="tel:+919798082076">+91 97980 82076</a>
          </li>
          <li>
            <span class="footer-contact-label">WhatsApp</span>
            <a href="https://wa.me/919798082076" target="_blank" rel="noopener">Chat with us</a>
          </li>
        </ul>
      </div>
    </div>

    <div class="footer-trust" aria-label="Government registrations">
      {trustBadges.map((b) => (
        <div class="footer-trust-card">
          <span class="footer-trust-tick" aria-hidden="true">
            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round"><polyline points="20 6 9 17 4 12"/></svg>
          </span>
          <div>
            <strong>{b.label}</strong>
            <span class="footer-trust-sub">{b.sub}</span>
            <span class="footer-trust-id">{b.id}</span>
          </div>
        </div>
      ))}
    </div>

    <div class="footer-bottom">
      <span>© {year} Quality Nexus Private Limited. All rights reserved.</span>
      <span class="footer-bottom-ids">
        CIN: U70200JH2025PTC024534 · GSTIN: 20AABCQ1018L1ZW
      </span>
    </div>
  </div>
</footer>

<style>
  .site-footer {
    background: var(--color-primary);
    color: #CBD5E1;
    padding: 72px 0 24px;
    margin-top: 0;
  }
  .footer-grid {
    display: grid;
    grid-template-columns: 1.4fr 1fr 1fr 1.2fr;
    gap: 48px;
    padding-bottom: 36px;
    border-bottom: 1px solid rgba(255, 255, 255, 0.08);
  }
  .footer-brand .brand {
    color: #fff;
    font-size: 18px;
    font-weight: 800;
    display: inline-flex;
    align-items: center;
    gap: 10px;
    margin-bottom: 16px;
  }
  .footer-brand .brand-mark {
    width: 40px;
    height: 40px;
    border-radius: 10px;
    object-fit: cover;
    display: block;
  }
  .footer-brand p {
    color: #94A3B8;
    font-size: 14px;
    line-height: 1.55;
    max-width: 320px;
    margin-bottom: 14px;
  }
  .footer-address {
    color: #CBD5E1;
    font-size: 13.5px;
    line-height: 1.55;
    font-style: normal;
    margin-bottom: 18px;
    max-width: 320px;
  }

  .footer-socials {
    list-style: none;
    margin: 0; padding: 0;
    display: flex;
    gap: 10px;
  }
  .footer-social {
    display: inline-grid;
    place-items: center;
    width: 36px; height: 36px;
    border-radius: 9px;
    background: rgba(255, 255, 255, 0.06);
    border: 1px solid rgba(255, 255, 255, 0.10);
    color: #CBD5E1;
    transition: background-color .15s ease, color .15s ease, border-color .15s ease;
  }
  .footer-social:hover {
    background: rgba(212, 175, 55, 0.16);
    border-color: rgba(212, 175, 55, 0.36);
    color: var(--color-gold);
  }

  .footer-col h4 {
    color: #fff;
    font-size: 13px;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.1em;
    margin-bottom: 16px;
  }
  .footer-col ul {
    list-style: none;
    margin: 0; padding: 0;
    display: grid;
    gap: 9px;
  }
  .footer-col a {
    color: #94A3B8;
    font-size: 14px;
    transition: color .15s ease;
  }
  .footer-col a:hover { color: #fff; }

  .footer-contact li {
    display: flex;
    flex-direction: column;
    gap: 2px;
  }
  .footer-contact-label {
    color: #64748B;
    font-size: 11px;
    font-weight: 700;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  /* ===== Trust badges row ===== */
  .footer-trust {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 12px;
    padding: 24px 0 22px;
    border-bottom: 1px solid rgba(255, 255, 255, 0.08);
  }
  .footer-trust-card {
    display: flex;
    align-items: flex-start;
    gap: 12px;
    background: rgba(255, 255, 255, 0.04);
    border: 1px solid rgba(255, 255, 255, 0.08);
    border-radius: 10px;
    padding: 12px 14px;
    transition: background .2s ease, border-color .2s ease;
  }
  .footer-trust-card:hover {
    background: rgba(255, 255, 255, 0.06);
    border-color: rgba(212, 175, 55, 0.35);
  }
  .footer-trust-tick {
    display: grid;
    place-items: center;
    width: 26px;
    height: 26px;
    border-radius: 50%;
    background: rgba(212, 175, 55, 0.16);
    color: var(--color-gold);
    flex-shrink: 0;
    margin-top: 1px;
  }
  .footer-trust-card strong {
    display: block;
    color: #fff;
    font-size: 13px;
    line-height: 1.2;
    font-family: var(--font-display);
    margin-bottom: 3px;
  }
  .footer-trust-sub {
    display: block;
    color: #94A3B8;
    font-size: 11.5px;
    line-height: 1.35;
    margin-bottom: 4px;
  }
  .footer-trust-id {
    display: block;
    color: var(--color-gold);
    font-size: 11px;
    font-family: var(--font-heading);
    letter-spacing: 0.01em;
    word-break: break-all;
  }

  .footer-bottom {
    display: flex;
    justify-content: space-between;
    align-items: center;
    flex-wrap: wrap;
    gap: 10px;
    padding-top: 22px;
    color: #64748B;
    font-size: 12.5px;
  }
  .footer-bottom-ids {
    color: #475569;
    font-family: var(--font-heading);
    letter-spacing: -0.01em;
  }

  @media (max-width: 900px) {
    .footer-grid {
      grid-template-columns: 1fr 1fr;
      gap: 36px;
    }
    .footer-trust { grid-template-columns: repeat(2, 1fr); }
  }
  @media (max-width: 560px) {
    .site-footer { padding: 56px 0 22px; }
    .footer-grid { grid-template-columns: 1fr; gap: 32px; }
    .footer-trust { grid-template-columns: 1fr; }
  }
</style>
