---
const year = new Date().getFullYear();
const exploreLinks = [
  { href: "/", label: "Home" },
  { href: "/about", label: "About" },
  { href: "/services", label: "Services" },
  { href: "/certifications", label: "Certifications" },
  { href: "/clients", label: "Clients" },
  { href: "/contact", label: "Contact" },
];
const popularStandards = [
  "ISO 9001",
  "ISO 14001",
  "ISO 45001",
  "ISO 27001",
  "ISO 13485",
  "ISO 22000",
];
---
<footer class="site-footer">
  <div class="container">
    <div class="footer-grid">
      <div class="footer-brand">
        <a href="/" class="brand">
          <span class="brand-mark" aria-hidden="true">QN</span>
          <span class="brand-name">QualityNexus</span>
        </a>
        <p>An ISO certification consulting partner that takes you from gap analysis to certificate — across 100+ international standards.</p>
        <p class="contact-line">
          <span>hello@qualitynexus.in</span>
          <span aria-hidden="true">·</span>
          <span>Mumbai, India</span>
        </p>
      </div>

      <div class="footer-col">
        <h4>Explore</h4>
        <ul>
          {exploreLinks.map((l) => (
            <li><a href={l.href}>{l.label}</a></li>
          ))}
        </ul>
      </div>

      <div class="footer-col">
        <h4>Popular standards</h4>
        <ul>
          {popularStandards.map((s) => (
            <li><a href={`/certifications/${s.toLowerCase().replace(/\s+/g, "-")}`}>{s}</a></li>
          ))}
        </ul>
      </div>

      <div class="footer-col">
        <h4>Talk to us</h4>
        <p>Tell us about your standard, your timeline, and the gaps you already know about. We'll come back with a plan within 48 hours.</p>
        <a href="/contact" class="btn btn-accent footer-cta">Start a conversation</a>
      </div>
    </div>

    <div class="footer-bottom">
      <span>© {year} QualityNexus. All rights reserved.</span>
      <span class="meta">Built lightweight on Astro · Self-hosted fonts · Static delivery</span>
    </div>
  </div>
</footer>

<style>
  .site-footer {
    background: var(--color-primary);
    color: #CBD5E1;
    padding: 88px 0 28px;
    margin-top: 0;
  }
  .footer-grid {
    display: grid;
    grid-template-columns: 1.5fr 1fr 1fr 1.4fr;
    gap: 56px;
    padding-bottom: 56px;
    border-bottom: 1px solid rgba(255, 255, 255, 0.08);
  }
  .footer-brand .brand {
    color: #fff;
    font-size: 18px;
    font-weight: 800;
    display: inline-flex;
    align-items: center;
    gap: 10px;
    margin-bottom: 18px;
  }
  .footer-brand .brand-mark {
    display: inline-grid;
    place-items: center;
    width: 34px; height: 34px;
    background: rgba(212, 175, 55, 0.16);
    color: var(--color-gold);
    border-radius: 9px;
    font-weight: 800;
    font-size: 13px;
  }
  .footer-brand p {
    color: #94A3B8;
    font-size: 15px;
    max-width: 360px;
    margin-bottom: 14px;
  }
  .contact-line {
    display: flex;
    gap: 10px;
    flex-wrap: wrap;
    color: #CBD5E1;
    font-size: 14px;
  }

  .footer-col h4 {
    color: #fff;
    font-size: 13px;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.1em;
    margin-bottom: 18px;
  }
  .footer-col ul { display: grid; gap: 10px; }
  .footer-col a {
    color: #94A3B8;
    font-size: 14px;
    transition: color .15s ease;
  }
  .footer-col a:hover { color: #fff; }
  .footer-col p {
    color: #94A3B8;
    font-size: 14px;
    margin-bottom: 18px;
  }
  .footer-cta {
    padding: 10px 18px;
    font-size: 14px;
  }

  .footer-bottom {
    display: flex;
    justify-content: space-between;
    align-items: center;
    flex-wrap: wrap;
    gap: 12px;
    padding-top: 28px;
    color: #64748B;
    font-size: 13px;
  }
  .footer-bottom .meta { color: #475569; }

  @media (max-width: 900px) {
    .footer-grid {
      grid-template-columns: 1fr 1fr;
      gap: 40px;
    }
  }
  @media (max-width: 560px) {
    .site-footer { padding: 56px 0 24px; }
    .footer-grid { grid-template-columns: 1fr; gap: 36px; }
  }
</style>
