---
import { Image } from "astro:assets";
import hero1 from "../assets/hero/hero-1.jpeg";
import hero2 from "../assets/hero/hero-2.jpeg";
import hero3 from "../assets/hero/hero-3.jpeg";
import hero4 from "../assets/hero/hero-4.jpeg";
import hero5 from "../assets/hero/hero-5.jpeg";
import hero6 from "../assets/hero/hero-6.jpeg";
import hero7 from "../assets/hero/hero-7.jpeg";

const slides = [
  { src: hero1, alt: "QualityNexus consultant and NHPC officials at an engagement meeting",         tag: "NHPC engagement" },
  { src: hero2, alt: "QualityNexus team with client staff and on-site safety officers",              tag: "Client site visit" },
  { src: hero3, alt: "Training session at Numaligarh Refinery Ltd with delegates working on laptops", tag: "NRL training cohort" },
  { src: hero4, alt: "Certificate handover ceremony with QualityNexus consultant and client team",   tag: "Certificate handover" },
  { src: hero5, alt: "Audit session in progress at NRL Learning Centre with delegates around a long table", tag: "On-site audit · NRL" },
  { src: hero6, alt: "QualityNexus internal training meeting around a conference table",             tag: "Internal training" },
  { src: hero7, alt: "Group photo of QualityNexus consultants with a client team after engagement", tag: "Post-engagement group" },
];
---
<div class="hero-carousel" data-hero-carousel>
  <div class="hc-frame">
    {slides.map((s, i) => (
      <figure class={`hc-slide ${i === 0 ? "is-active" : ""}`} data-hc-slide>
        <Image
          src={s.src}
          alt={s.alt}
          widths={[640, 960, 1280]}
          sizes="(max-width: 640px) 100vw, (max-width: 980px) 80vw, 560px"
          formats={["avif", "webp"]}
          quality={70}
          loading={i === 0 ? "eager" : "lazy"}
          decoding={i === 0 ? "sync" : "async"}
        />
        <figcaption class="hc-cap">
          <span class="hc-cap-tag">{s.tag}</span>
        </figcaption>
      </figure>
    ))}

    <div class="hc-overlay-pill">
      <span class="hc-pulse" aria-hidden="true"><span></span></span>
      Live · trusted partner across India
    </div>

    <div class="hc-corner hc-corner--tl" aria-hidden="true"></div>
    <div class="hc-corner hc-corner--br" aria-hidden="true"></div>
  </div>

  <div class="hc-dots" role="tablist" aria-label="Hero photo carousel">
    {slides.map((_, i) => (
      <button
        type="button"
        class={`hc-dot ${i === 0 ? "is-active" : ""}`}
        data-hc-dot={i}
        role="tab"
        aria-label={`Show slide ${i + 1}`}
        aria-selected={i === 0 ? "true" : "false"}
      ></button>
    ))}
  </div>
</div>

<script src="/scripts/hero-carousel.js" defer></script>

<style>
  .hero-carousel {
    position: relative;
    width: 100%;
    max-width: 560px;
    margin-left: auto;
    display: flex;
    flex-direction: column;
    gap: 14px;
  }
  .hc-frame {
    position: relative;
    width: 100%;
    aspect-ratio: 4 / 3;
    border-radius: 22px;
    overflow: hidden;
    background: var(--color-bg-section);
    box-shadow:
      0 30px 70px rgba(15, 59, 46, 0.18),
      0 4px 14px rgba(15, 59, 46, 0.06),
      0 0 0 1px rgba(15, 59, 46, 0.06);
    isolation: isolate;
  }

  .hc-slide {
    position: absolute;
    inset: 0;
    margin: 0;
    opacity: 0;
    transform: scale(1.04);
    transition: opacity 700ms ease, transform 6000ms ease-out;
    will-change: opacity, transform;
  }
  .hc-slide.is-active {
    opacity: 1;
    transform: scale(1);
  }
  .hc-slide img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center;
    display: block;
    filter: saturate(1.02) contrast(1.02);
  }

  .hc-cap {
    position: absolute;
    left: 0; right: 0; bottom: 0;
    padding: 56px 22px 18px;
    background: linear-gradient(180deg, rgba(14, 59, 46, 0) 0%, rgba(14, 59, 46, 0.55) 60%, rgba(14, 59, 46, 0.85) 100%);
    pointer-events: none;
  }
  .hc-cap-tag {
    display: inline-flex;
    align-items: center;
    padding: 5px 12px;
    border-radius: 999px;
    background: rgba(255, 255, 255, 0.14);
    border: 1px solid rgba(255, 255, 255, 0.22);
    color: #fff;
    font-size: 11px;
    font-weight: 700;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    backdrop-filter: blur(4px);
    -webkit-backdrop-filter: blur(4px);
  }

  .hc-overlay-pill {
    position: absolute;
    top: 14px;
    left: 14px;
    display: inline-flex;
    align-items: center;
    gap: 8px;
    background: rgba(255, 255, 255, 0.92);
    border: 1px solid rgba(15, 59, 46, 0.10);
    color: var(--color-heading);
    font-size: 11.5px;
    font-weight: 700;
    letter-spacing: 0.02em;
    padding: 6px 12px;
    border-radius: 999px;
    box-shadow: 0 6px 18px rgba(15, 59, 46, 0.14);
    z-index: 3;
    backdrop-filter: blur(6px);
    -webkit-backdrop-filter: blur(6px);
  }
  .hc-pulse {
    position: relative;
    width: 8px; height: 8px;
  }
  .hc-pulse > span {
    position: absolute; inset: 0;
    border-radius: 50%;
    background: #10B981;
    box-shadow: 0 0 0 0 rgba(16, 185, 129, 0.6);
    animation: hcLivePulse 1.6s ease-out infinite;
  }
  @keyframes hcLivePulse {
    0%   { box-shadow: 0 0 0 0 rgba(16, 185, 129, 0.55); }
    70%  { box-shadow: 0 0 0 8px rgba(16, 185, 129, 0); }
    100% { box-shadow: 0 0 0 0 rgba(16, 185, 129, 0); }
  }

  /* Decorative gold corner accents */
  .hc-corner {
    position: absolute;
    width: 28px; height: 28px;
    pointer-events: none;
    z-index: 2;
  }
  .hc-corner--tl {
    top: 14px; right: 14px;
    border-top: 2px solid var(--color-gold);
    border-right: 2px solid var(--color-gold);
    border-top-right-radius: 8px;
  }
  .hc-corner--br {
    bottom: 14px; right: 14px;
    border-bottom: 2px solid var(--color-gold);
    border-right: 2px solid var(--color-gold);
    border-bottom-right-radius: 8px;
  }

  /* Dot indicators */
  .hc-dots {
    display: flex;
    justify-content: center;
    align-items: center;
    gap: 8px;
    padding: 4px 0 2px;
  }
  .hc-dot {
    width: 8px;
    height: 8px;
    border-radius: 999px;
    border: none;
    background: rgba(15, 59, 46, 0.18);
    cursor: pointer;
    padding: 0;
    transition: background-color .25s ease, transform .25s ease, width .3s ease;
  }
  .hc-dot:hover { background: rgba(15, 59, 46, 0.32); }
  .hc-dot.is-active {
    background: var(--color-primary);
    width: 22px;
  }

  @media (prefers-reduced-motion: reduce) {
    .hc-slide,
    .hc-pulse > span {
      transition: none;
      animation: none;
    }
  }

  @media (max-width: 980px) {
    .hero-carousel { max-width: 100%; margin: 0 auto; }
  }
  @media (max-width: 640px) {
    .hc-frame { aspect-ratio: 4 / 3; border-radius: 18px; }
    .hc-overlay-pill { font-size: 10.5px; padding: 5px 10px; }
    .hc-cap { padding: 42px 16px 14px; }
  }
</style>
