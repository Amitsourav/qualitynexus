---
import "../styles/global.css";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";

interface Props {
  title?: string;
  description?: string;
  canonical?: string;
}

const {
  title = "QualityNexus — ISO Certification Consulting",
  description = "Your partner in ISO compliance — from gap to certificate. Consulting, training, implementation, and audits across 100+ international standards.",
  canonical,
} = Astro.props;

const pageTitle = title.includes("QualityNexus")
  ? title
  : `${title} · QualityNexus`;
---
<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <meta name="generator" content={Astro.generator} />
  <meta name="theme-color" content="#0E3B2E" />
  <meta name="description" content={description} />
  <meta property="og:title" content={pageTitle} />
  <meta property="og:description" content={description} />
  <meta property="og:type" content="website" />
  {canonical && <link rel="canonical" href={canonical} />}
  <link rel="icon" type="image/png" href="/favicon.png" />
  <link rel="apple-touch-icon" href="/logo-256.png" />
  <title>{pageTitle}</title>
</head>
<body>
  <Header />
  <main id="main"><slot /></main>
  <Footer />
</body>
</html>
