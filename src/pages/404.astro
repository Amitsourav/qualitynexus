---
import BaseLayout from "../layouts/BaseLayout.astro";
import Icon from "../components/Icon.astro";
---
<BaseLayout
  title="Page not found - QualityNexus"
  description="The page you were looking for doesn't exist or has moved. Try one of the links below to get back on track."
  noindex
>
  <section class="nf-section">
    <div class="container nf-inner">
      <span class="nf-eyebrow">Error 404</span>
      <h1 class="nf-title">
        That page slipped through<br/>
        <span class="nf-accent">an internal audit.</span>
      </h1>
      <p class="nf-lede">
        The link you followed doesn't match anything on QualityNexus.in - it may have moved, been renamed,
        or never existed. Pick a starting point below and we'll get you to the right place.
      </p>

      <div class="nf-cards">
        <a href="/services/" class="nf-card">
          <span class="nf-card-icon"><Icon name="cog" /></span>
          <strong>Services</strong>
          <span>Six service lines, twenty offerings under one roof.</span>
        </a>
        <a href="/certifications/" class="nf-card">
          <span class="nf-card-icon"><Icon name="award" /></span>
          <strong>Certifications</strong>
          <span>Browse 100+ international standards by domain.</span>
        </a>
        <a href="/clients/" class="nf-card">
          <span class="nf-card-icon"><Icon name="users" /></span>
          <strong>Clients</strong>
          <span>Featured PSU and enterprise engagements.</span>
        </a>
        <a href="/contact/" class="nf-card">
          <span class="nf-card-icon"><Icon name="headphones" /></span>
          <strong>Contact</strong>
          <span>Email, phone, WhatsApp, and our Ranchi office.</span>
        </a>
      </div>

      <div class="nf-back">
        <a href="/" class="btn btn-accent">Back to home <Icon name="arrow-right" /></a>
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  .nf-section {
    position: relative;
    padding: 96px 0 88px;
    background: linear-gradient(180deg, #FFFFFF 0%, var(--color-bg-soft) 100%);
    isolation: isolate;
  }
  .nf-section::before {
    content: "";
    position: absolute;
    top: -80px; right: -120px;
    width: 460px; height: 460px;
    border-radius: 50%;
    background: radial-gradient(closest-side, rgba(212, 175, 55, 0.22), transparent);
    filter: blur(80px);
    z-index: -1;
  }
  .nf-section::after {
    content: "";
    position: absolute;
    bottom: -120px; left: -120px;
    width: 420px; height: 420px;
    border-radius: 50%;
    background: radial-gradient(closest-side, rgba(16, 185, 129, 0.18), transparent);
    filter: blur(80px);
    z-index: -1;
  }
  .nf-inner { max-width: 880px; }
  .nf-eyebrow {
    display: inline-block;
    color: var(--color-accent-strong);
    font-size: 12px;
    font-weight: 700;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    margin-bottom: 14px;
  }
  .nf-title {
    font-size: clamp(2rem, 4vw, 3rem);
    line-height: 1.05;
    letter-spacing: -0.02em;
    color: var(--color-heading);
    margin-bottom: 18px;
  }
  .nf-accent {
    background: linear-gradient(110deg, #E8C766 0%, var(--color-gold) 50%, #F4D580 100%);
    -webkit-background-clip: text;
    background-clip: text;
    color: transparent;
  }
  .nf-lede {
    font-size: 17px;
    color: var(--color-text);
    max-width: 640px;
    line-height: 1.6;
    margin-bottom: 36px;
  }
  .nf-cards {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 14px;
    margin-bottom: 32px;
  }
  .nf-card {
    display: flex;
    flex-direction: column;
    gap: 6px;
    padding: 22px 22px 20px;
    border: 1px solid var(--color-border);
    border-radius: var(--radius-lg);
    background: #fff;
    color: var(--color-heading);
    text-decoration: none;
    transition: transform .2s ease, box-shadow .2s ease, border-color .2s ease;
  }
  .nf-card:hover {
    transform: translateY(-3px);
    box-shadow: var(--shadow-md);
    border-color: rgba(16, 185, 129, 0.32);
  }
  .nf-card-icon {
    width: 40px; height: 40px;
    border-radius: 10px;
    background: var(--color-accent-soft);
    color: var(--color-accent-strong);
    display: grid; place-items: center;
    margin-bottom: 4px;
  }
  .nf-card-icon :global(svg) { width: 20px; height: 20px; }
  .nf-card strong { font-size: 16px; font-weight: 700; }
  .nf-card span { color: var(--color-text); font-size: 13.5px; line-height: 1.5; }

  @media (max-width: 640px) {
    .nf-cards { grid-template-columns: 1fr; }
    .nf-section { padding: 64px 0 56px; }
  }
</style>
