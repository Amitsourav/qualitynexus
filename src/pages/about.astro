---
import BaseLayout from "../layouts/BaseLayout.astro";
import PageHero from "../components/PageHero.astro";
import CtaStrip from "../components/CtaStrip.astro";
import Icon from "../components/Icon.astro";

const principles = [
  { icon: "shield-check", title: "Audit-defensible by design",  body: "Every artefact we produce can withstand external scrutiny — because our consultants have written the same notes from the auditor's seat." },
  { icon: "compass",      title: "Pragmatic over ceremonial",   body: "Documentation that your team will actually open. Controls that fit how you already work. No 200-page binders." },
  { icon: "users",        title: "Same lead, end-to-end",        body: "The senior consultant on day one is the consultant on certification day. No handoffs, no retraining, no surprises." },
  { icon: "trending-up",  title: "Built to recertify",           body: "Surveillance audits, internal audits, and re-certification are easier — because we wire them into the system from day zero." },
];

const industries = [
  { icon: "stethoscope", label: "Healthcare & Medical Devices" },
  { icon: "cog",         label: "Manufacturing & Heavy Industry" },
  { icon: "lock",        label: "Software, SaaS & Fintech" },
  { icon: "utensils",    label: "Food, Beverage & Pharma" },
  { icon: "leaf",        label: "Energy & Sustainability" },
  { icon: "battery",     label: "Logistics & Supply Chain" },
  { icon: "scale",       label: "Banking, Insurance & NBFC" },
  { icon: "rocket",      label: "Aerospace & Defence" },
];

const credentials = [
  { num: "12+",   label: "Years average sector experience per lead consultant" },
  { num: "100+",  label: "International standards covered across our team" },
  { num: "8",     label: "Featured PSU &amp; enterprise client engagements" },
  { num: "6",     label: "Industry sectors served, pan-India" },
];

const credentialBadges = [
  { code: "ISO 9001",  label: "Quality" },
  { code: "ISO 27001", label: "InfoSec" },
  { code: "ISO 14001", label: "Environment" },
  { code: "ISO 45001", label: "Safety" },
];
---
<BaseLayout
  title="About QualityNexus — ISO Consulting from Senior Auditors"
  description="QualityNexus is an ISO certification consulting firm built by senior IRCA-trained lead auditors. We help organizations move from gap analysis to certificate across 100+ international standards."
>
  <PageHero
    eyebrow="About QualityNexus"
    title="A trusted consultancy and"
    accent="training company across India."
    lede="QualityNexus is a trusted consultancy and training company offering expert services in ISO Certification (9001, 14001, 45001, etc.), NABL & NABH Accreditation, Cybersecurity Audits, ESG, Safety Audits, T4S, Water Audit, and Lean Six Sigma — alongside Business Coaching, Financial Services, Legal Compliance, and Digital solutions."
    hasVisual={true}
  >
    <div slot="visual" class="about-visual">
      <div class="about-pill about-pill--top">
        <span class="about-pulse" aria-hidden="true"><span></span></span>
        MSME · DIPP · GST · MCA registered
      </div>

      <div class="about-stage">
        <div class="about-orbit about-orbit--outer" aria-hidden="true"></div>
        <div class="about-orbit about-orbit--inner" aria-hidden="true"></div>

        <div class="about-seal">
          <div class="about-seal-inner">
            <Icon name="shield-check" />
            <strong>Senior</strong>
            <span>Lead Auditor</span>
          </div>
        </div>

        {credentialBadges.map((b, i) => (
          <div class={`about-badge about-badge--${i}`}>
            <span class="about-badge-icon"><Icon name="check-circle" /></span>
            <div>
              <strong>{b.code}</strong>
              <span>{b.label}</span>
            </div>
          </div>
        ))}
      </div>

      <div class="about-pill about-pill--bottom">
        <Icon name="award" />
        12+ years average sector experience
      </div>
    </div>
  </PageHero>

  <!-- ========== STORY ========== -->
  <section class="section">
    <div class="container story-grid">
      <div class="story-copy">
        <span class="eyebrow">Who we are</span>
        <h2>One partner for compliance, training, and business support.</h2>
        <p>
          We also provide Business Coaching, Business Audits, Financial Services (GST, ITR, TDS),
          Legal Compliance, Startup Registration, Digital Marketing, Software &amp; Mobile App Development,
          and Green Certifications.
        </p>
        <p>
          Our team of certified professionals delivers customized, result-oriented solutions across India
          to help businesses achieve compliance, efficiency, and sustainable growth.
        </p>
        <ul class="story-bullets">
          <li><Icon name="check-circle" /> Certified professionals across every service line</li>
          <li><Icon name="check-circle" /> Customized, result-oriented engagements</li>
          <li><Icon name="check-circle" /> Pan-India coverage, single point of contact</li>
        </ul>
      </div>
      <div class="story-photo">
        <img src="/images/handshake.jpg" alt="Two professionals shaking hands in a meeting" loading="lazy" width="640" height="800" />
        <figure class="story-quote-card">
          <span class="story-quote-mark" aria-hidden="true">"</span>
          <blockquote>
            Compliance, efficiency, and sustainable growth — delivered as one engagement, not three vendors.
          </blockquote>
          <figcaption>
            <strong>QualityNexus</strong>
            <span>Certified for Success</span>
          </figcaption>
        </figure>
      </div>
    </div>
  </section>

  <!-- ========== PRINCIPLES ========== -->
  <section class="section section-soft">
    <div class="container">
      <div class="section-head center">
        <span class="eyebrow">How we work</span>
        <h2>Four principles. One outcome.</h2>
        <p>The rules we run our engagements by — drawn from a decade of audit findings we've watched, written, and closed.</p>
      </div>
      <div class="principles-grid">
        {principles.map((p, i) => (
          <article class="principle-card">
            <span class="principle-num">{String(i + 1).padStart(2, "0")}</span>
            <span class="icon-halo"><Icon name={p.icon} /></span>
            <h3>{p.title}</h3>
            <p>{p.body}</p>
          </article>
        ))}
      </div>
    </div>
  </section>

  <!-- ========== INDUSTRIES ========== -->
  <section class="section">
    <div class="container industry-section-grid">
      <div class="industry-copy">
        <span class="eyebrow">Sectors we operate in</span>
        <h2>Industry context, not generic templates.</h2>
        <p>Each engagement is led by a consultant whose background matches your sector — because the same standard reads very differently inside a hospital, a bank, and a battery plant.</p>
        <a href="/services" class="link-arrow">See how we engage <Icon name="arrow-right" /></a>
      </div>
      <ul class="industry-grid">
        {industries.map((i) => (
          <li class="industry-card">
            <span class="industry-icon"><Icon name={i.icon} /></span>
            <span class="industry-label">{i.label}</span>
          </li>
        ))}
      </ul>
    </div>
  </section>

  <!-- ========== EVENTS / TRAINING GALLERY ========== -->
  <section class="section section-soft">
    <div class="container">
      <div class="section-head center">
        <span class="eyebrow">Training &amp; events</span>
        <h2>Inside our seminars, sites, and labs.</h2>
        <p>Real moments from QualityNexus training programs and on-site engagements — not stock photography.</p>
      </div>
      <div class="events-grid">
        <figure class="event-tile event-tile--feature">
          <img src="/images/events/seminar-training.jpg" alt="Participants seated in a U-shape arrangement during a QualityNexus training session, with projector and presentation laptop in the foreground" loading="lazy" />
          <figcaption class="event-cap">
            <span class="event-cap-tag">Training session</span>
            <span class="event-cap-text">Auditor-prep workshop in our training hall</span>
          </figcaption>
        </figure>
        <figure class="event-tile">
          <img src="/images/events/site-audit.jpg" alt="Technical drawings, measurement instruments and notebook on a desk during a documentation review" loading="lazy" />
          <figcaption class="event-cap">
            <span class="event-cap-tag">On-site audit</span>
            <span class="event-cap-text">Documentation &amp; spec review walk-through</span>
          </figcaption>
        </figure>
        <figure class="event-tile">
          <img src="/images/events/lab-audit.jpg" alt="Laboratory bench with reagents and analytical equipment during a NABL accreditation visit" loading="lazy" />
          <figcaption class="event-cap">
            <span class="event-cap-tag">NABL accreditation</span>
            <span class="event-cap-text">Lab readiness review · ISO 17025</span>
          </figcaption>
        </figure>
      </div>
    </div>
  </section>

  <!-- ========== RECOGNITION / REGISTRATIONS PROOF STRIP ========== -->
  <section class="section">
    <div class="container">
      <div class="section-head center">
        <span class="eyebrow">Recognized &amp; registered</span>
        <h2>The paperwork behind the practice.</h2>
        <p>Government of India registrations and recognitions held by QualityNexus.</p>
      </div>
      <div class="recog-grid">
        <figure class="recog-tile">
          <img src="/images/events/cert-mca-incorp.jpg" alt="Ministry of Corporate Affairs Certificate of Incorporation issued by the Government of India to QualityNexus" loading="lazy" />
          <figcaption>MCA Certificate of Incorporation</figcaption>
        </figure>
        <figure class="recog-tile">
          <img src="/images/events/cert-msme-udyam.jpg" alt="MSME Udyam Registration Certificate issued by the Ministry of Micro, Small and Medium Enterprises to QualityNexus" loading="lazy" />
          <figcaption>MSME · Udyam Registration</figcaption>
        </figure>
        <figure class="recog-tile">
          <img src="/images/events/cert-startup-india.jpg" alt="Department for Promotion of Industry and Internal Trade (DIPP) Startup India Certificate of Recognition issued to QualityNexus" loading="lazy" />
          <figcaption>DIPP · Startup India recognition</figcaption>
        </figure>
        <figure class="recog-tile">
          <img src="/images/events/cert-gst.jpg" alt="GST Registration Certificate issued by the Government of India to QualityNexus" loading="lazy" />
          <figcaption>GST Registration · Form REG-06</figcaption>
        </figure>
      </div>
    </div>
  </section>

  <!-- ========== CREDIBILITY STRIP ========== -->
  <section class="section section-dark cred-section">
    <img src="/images/team-meeting.jpg" alt="" class="cred-bg-img" aria-hidden="true" loading="lazy" />
    <div class="container cred-inner">
      <div class="section-head center">
        <span class="eyebrow eyebrow-on-dark">By the numbers</span>
        <h2>What our track record looks like.</h2>
      </div>
      <div class="cred-grid">
        {credentials.map((c) => (
          <div class="cred-card">
            <strong class="cred-num">{c.num}</strong>
            <span class="cred-label">{c.label}</span>
          </div>
        ))}
      </div>
    </div>
  </section>

  <CtaStrip
    heading="Want to know if we're a fit for your standard?"
    body="Tell us your standard, your timeline, and what's already in place. We'll come back within 48 hours with an honest read."
    ctaLabel="Talk to a senior consultant"
  />
</BaseLayout>

<style>
  /* ===== HERO VISUAL — compact, 3-row layout ===== */
  .about-visual {
    position: relative;
    width: 100%;
    max-width: 460px;
    margin-left: auto;
    display: grid;
    grid-template-rows: auto 1fr auto;
    gap: 16px;
    align-items: center;
    justify-items: center;
  }
  .about-stage {
    position: relative;
    width: 100%;
    aspect-ratio: 1 / 1;
    max-width: 380px;
  }
  .about-orbit {
    position: absolute;
    top: 50%; left: 50%;
    border-radius: 50%;
  }
  .about-orbit--outer {
    width: 92%; height: 92%;
    transform: translate(-50%, -50%);
    border: 1px dashed rgba(15, 59, 46, 0.22);
    animation: aboutOrbitSpin 60s linear infinite;
  }
  .about-orbit--inner {
    width: 56%; height: 56%;
    transform: translate(-50%, -50%);
    border: 1px dashed rgba(16, 185, 129, 0.36);
    animation: aboutOrbitSpin 40s linear infinite reverse;
  }
  @keyframes aboutOrbitSpin {
    from { transform: translate(-50%, -50%) rotate(0deg); }
    to   { transform: translate(-50%, -50%) rotate(360deg); }
  }
  .about-seal {
    position: absolute;
    top: 50%; left: 50%;
    width: 36%;
    aspect-ratio: 1;
    transform: translate(-50%, -50%);
    background: radial-gradient(circle at 30% 30%, var(--color-primary-soft), var(--color-primary));
    border-radius: 50%;
    box-shadow: 0 14px 38px rgba(15, 59, 46, 0.30), inset 0 0 0 4px rgba(212, 175, 55, 0.20);
    display: grid;
    place-items: center;
    z-index: 2;
  }
  .about-seal-inner {
    text-align: center;
    color: #fff;
    display: grid;
    place-items: center;
    gap: 2px;
  }
  .about-seal-inner :global(.qn-icon) {
    font-size: 24px;
    color: var(--color-gold);
    margin-bottom: 2px;
  }
  .about-seal-inner strong {
    font-family: var(--font-heading);
    font-size: 13px;
    font-weight: 800;
    letter-spacing: 0.02em;
    color: #fff;
  }
  .about-seal-inner span {
    font-size: 9.5px;
    color: var(--color-gold);
    letter-spacing: 0.10em;
    text-transform: uppercase;
    font-weight: 700;
  }
  .about-badge {
    position: absolute;
    background: #fff;
    border: 1px solid var(--color-border);
    border-radius: var(--radius-md);
    padding: 9px 12px;
    box-shadow: var(--shadow-md);
    display: flex;
    align-items: center;
    gap: 9px;
    z-index: 3;
    white-space: nowrap;
  }
  /* Position badges at the 4 cardinal directions of the outer orbit */
  .about-badge--0 { top: 6%;   left: -2%;   animation: aboutBadgeFloat 7s ease-in-out infinite; }
  .about-badge--1 { top: 4%;   right: -2%;  animation: aboutBadgeFloat 8s ease-in-out infinite 1s; }
  .about-badge--2 { bottom: 8%; left: -4%;  animation: aboutBadgeFloat 9s ease-in-out infinite 1.5s; }
  .about-badge--3 { bottom: 6%; right: -2%; animation: aboutBadgeFloat 7.5s ease-in-out infinite 0.5s; }
  @keyframes aboutBadgeFloat {
    0%, 100% { transform: translateY(0); }
    50%      { transform: translateY(-5px); }
  }
  .about-badge-icon {
    display: inline-grid;
    place-items: center;
    width: 24px; height: 24px;
    border-radius: 6px;
    background: var(--color-accent-soft);
    color: var(--color-accent-strong);
    font-size: 12px;
    flex-shrink: 0;
  }
  .about-badge strong {
    display: block;
    font-family: var(--font-heading);
    font-size: 12px;
    font-weight: 800;
    color: var(--color-heading);
    line-height: 1.1;
  }
  .about-badge span {
    display: block;
    font-size: 10px;
    color: var(--color-text-muted);
    letter-spacing: 0.04em;
    line-height: 1.2;
  }

  .about-pill {
    background: #fff;
    border: 1px solid var(--color-border);
    border-radius: 999px;
    padding: 8px 14px;
    font-size: 12px;
    font-weight: 600;
    color: var(--color-heading);
    display: inline-flex;
    align-items: center;
    gap: 8px;
    box-shadow: var(--shadow-sm);
    white-space: nowrap;
  }
  .about-pill :global(.qn-icon) { color: var(--color-gold-strong); font-size: 14px; }
  .about-pulse {
    position: relative;
    width: 8px; height: 8px;
  }
  .about-pulse > span {
    position: absolute;
    inset: 0;
    border-radius: 50%;
    background: var(--color-accent);
    box-shadow: 0 0 0 0 rgba(16,185,129,0.6);
    animation: aboutPulse 2.4s ease-out infinite;
  }
  @keyframes aboutPulse {
    0%   { box-shadow: 0 0 0 0 rgba(16,185,129,0.6); }
    70%  { box-shadow: 0 0 0 10px rgba(16,185,129,0); }
    100% { box-shadow: 0 0 0 0 rgba(16,185,129,0); }
  }

  /* ===== STORY ===== */
  .story-grid {
    display: grid;
    grid-template-columns: 1.2fr 1fr;
    gap: 64px;
    align-items: center;
  }
  .story-copy h2 { margin: 14px 0 18px; }
  .story-copy p { margin-bottom: 14px; font-size: 17px; line-height: 1.7; }
  .story-bullets {
    margin-top: 22px;
    display: grid;
    gap: 10px;
  }
  .story-bullets li {
    display: flex;
    align-items: flex-start;
    gap: 10px;
    color: var(--color-heading);
    font-size: 14.5px;
    font-weight: 500;
  }
  .story-bullets li :global(.qn-icon) {
    color: var(--color-accent);
    flex-shrink: 0;
    margin-top: 3px;
  }

  .story-photo {
    position: relative;
  }
  .story-photo img {
    width: 100%;
    aspect-ratio: 4 / 5;
    object-fit: cover;
    border-radius: var(--radius-xl);
    box-shadow: var(--shadow-lg);
  }
  .story-quote-card {
    position: absolute;
    left: -32px;
    bottom: -32px;
    max-width: 320px;
    background: var(--color-primary);
    color: #fff;
    border-radius: var(--radius-lg);
    padding: 24px 24px 20px;
    box-shadow: 0 24px 48px rgba(15, 59, 46, 0.25);
  }
  .story-quote-mark {
    position: absolute;
    top: -10px;
    left: 18px;
    font-family: var(--font-heading);
    font-size: 60px;
    line-height: 1;
    color: #34D399;
  }
  .story-quote-card blockquote {
    font-family: var(--font-heading);
    color: #fff;
    font-size: 15px;
    line-height: 1.5;
    font-weight: 600;
    margin: 8px 0 16px;
    letter-spacing: -0.005em;
  }
  .story-quote-card figcaption {
    border-top: 1px solid rgba(255,255,255,0.12);
    padding-top: 12px;
    display: grid;
    gap: 2px;
  }
  .story-quote-card figcaption strong {
    color: #fff;
    font-size: 13px;
    font-weight: 700;
  }
  .story-quote-card figcaption span {
    color: #34D399;
    font-size: 11px;
    letter-spacing: 0.06em;
    text-transform: uppercase;
  }

  /* ===== PRINCIPLES ===== */
  .principles-grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 24px;
  }
  .principle-card {
    position: relative;
    background: var(--color-bg);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-lg);
    padding: 32px;
    transition: transform .2s ease, box-shadow .2s ease;
    overflow: hidden;
  }
  .principle-card:hover {
    transform: translateY(-3px);
    box-shadow: var(--shadow-md);
  }
  .principle-num {
    position: absolute;
    top: 22px;
    right: 26px;
    font-family: var(--font-heading);
    font-size: 36px;
    font-weight: 800;
    color: rgba(16, 185, 129, 0.20);
    line-height: 1;
    letter-spacing: -0.04em;
  }
  .icon-halo {
    display: inline-grid;
    place-items: center;
    width: 48px; height: 48px;
    border-radius: 12px;
    background: var(--color-accent-soft);
    color: var(--color-accent-strong);
    font-size: 22px;
    margin-bottom: 18px;
  }
  .principle-card h3 { margin-bottom: 10px; }
  .principle-card p { color: var(--color-text); }

  /* ===== INDUSTRIES ===== */
  .industry-section-grid {
    display: grid;
    grid-template-columns: 1fr 1.5fr;
    gap: 56px;
    align-items: center;
  }
  .industry-copy h2 { margin: 14px 0 16px; }
  .industry-copy p { color: var(--color-text); font-size: 16px; margin-bottom: 22px; line-height: 1.65; }
  .link-arrow {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    color: var(--color-accent-strong);
    font-weight: 600;
    font-size: 14px;
  }
  .link-arrow:hover { gap: 10px; }

  .industry-grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 14px;
  }
  .industry-card {
    display: flex;
    align-items: center;
    gap: 12px;
    padding: 16px;
    background: var(--color-bg);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-md);
    transition: border-color .2s ease, transform .2s ease;
  }
  .industry-card:hover {
    border-color: var(--color-accent);
    transform: translateY(-2px);
  }
  .industry-icon {
    display: inline-grid;
    place-items: center;
    width: 36px; height: 36px;
    border-radius: 8px;
    background: var(--color-accent-tint);
    color: var(--color-accent-strong);
    font-size: 16px;
    flex-shrink: 0;
  }
  .industry-label {
    font-size: 14px;
    font-weight: 600;
    color: var(--color-heading);
    line-height: 1.3;
  }

  /* ===== EVENTS / TRAINING GALLERY ===== */
  .events-grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    grid-auto-rows: 240px;
    gap: 16px;
  }
  .event-tile--feature {
    grid-row: span 2;
  }
  .event-tile {
    position: relative;
    margin: 0;
    border-radius: var(--radius-lg);
    overflow: hidden;
    background: var(--color-bg);
    border: 1px solid var(--color-border);
    transition: transform .2s ease, box-shadow .2s ease;
  }
  .event-tile:hover {
    transform: translateY(-3px);
    box-shadow: var(--shadow-md);
  }
  .event-tile img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }
  .event-cap {
    position: absolute;
    left: 0;
    right: 0;
    bottom: 0;
    padding: 16px 18px 14px;
    display: flex;
    flex-direction: column;
    gap: 4px;
    background: linear-gradient(180deg, rgba(14, 59, 46, 0) 0%, rgba(14, 59, 46, 0.72) 60%, rgba(14, 59, 46, 0.92) 100%);
    color: #fff;
  }
  .event-cap-tag {
    display: inline-block;
    width: fit-content;
    padding: 3px 10px;
    border-radius: 999px;
    background: rgba(255, 255, 255, 0.12);
    border: 1px solid rgba(255, 255, 255, 0.22);
    color: #fff;
    font-size: 11px;
    font-weight: 600;
    letter-spacing: 0.06em;
    text-transform: uppercase;
  }
  .event-cap-text {
    font-size: 14px;
    font-weight: 500;
    color: rgba(255, 255, 255, 0.95);
  }
  @media (max-width: 860px) {
    .events-grid { grid-template-columns: 1fr; grid-auto-rows: 220px; }
    .event-tile--feature { grid-row: span 1; }
  }

  /* ===== RECOGNITION GRID (govt cert thumbnails) ===== */
  .recog-grid {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 18px;
  }
  .recog-tile {
    margin: 0;
    background: var(--color-bg);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-lg);
    padding: 16px 16px 14px;
    box-shadow: var(--shadow-sm);
    display: flex;
    flex-direction: column;
    gap: 12px;
    transition: transform .2s ease, box-shadow .2s ease;
  }
  .recog-tile:hover {
    transform: translateY(-3px);
    box-shadow: var(--shadow-md);
  }
  .recog-tile img {
    width: 100%;
    aspect-ratio: 4 / 3;
    object-fit: cover;
