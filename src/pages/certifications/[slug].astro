---
import BaseLayout from "../../layouts/BaseLayout.astro";
import CtaStrip from "../../components/CtaStrip.astro";
import Icon from "../../components/Icon.astro";
import { allStandards, details, slugify } from "../../data/certifications";

export async function getStaticPaths() {
  return allStandards.map((s) => ({
    params: { slug: s.slug },
    props: { standard: s },
  }));
}

const { standard } = Astro.props;
const detail = details[standard.slug];
const hasDetail = Boolean(detail);
const cat = standard.category;

// Pillar guides - extend this map as new pillar pages ship.
const pillarFor: Record<string, { href: string; label: string }> = {
  "iso-27001": { href: "/iso-27001-consultant-india/", label: "ISO 27001 Consultant in India - full implementation guide" },
};
const pillar = pillarFor[standard.slug];

const benefitIcons = ["users", "settings", "compass", "trending-up"];
const whyIcons = ["check-circle", "shield-check", "graduation-cap", "scale", "rocket"];

function trimMeta(text: string, max = 158): string {
  if (text.length <= max) return text;
  const cut = text.slice(0, max);
  const lastSpace = cut.lastIndexOf(" ");
  return cut.slice(0, lastSpace > 0 ? lastSpace : max).replace(/[,;:.\s]+$/, "") + "…";
}

const metaDescription = hasDetail
  ? trimMeta(detail.intro)
  : `${standard.code} (${standard.name}) consulting, training, implementation, and audit support from QualityNexus.`;

const canonicalPath = `/certifications/${standard.slug}/`;
const canonicalUrl = `https://www.qualitynexus.in${canonicalPath}`;

const breadcrumbLd = {
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  "itemListElement": [
    { "@type": "ListItem", "position": 1, "name": "Home",           "item": "https://www.qualitynexus.in/" },
    { "@type": "ListItem", "position": 2, "name": "Certifications", "item": "https://www.qualitynexus.in/certifications/" },
    { "@type": "ListItem", "position": 3, "name": cat.title,         "item": `https://www.qualitynexus.in/certifications/#${cat.id}` },
    { "@type": "ListItem", "position": 4, "name": standard.code,     "item": canonicalUrl },
  ],
};

const serviceLd = {
  "@context": "https://schema.org",
  "@type": "Service",
  "serviceType": `${standard.name} Certification Consulting`,
  "name": `${standard.code} - ${standard.name} Consulting & Implementation`,
  "description": metaDescription,
  "provider": { "@id": "https://www.qualitynexus.in/#organization" },
  "areaServed": { "@type": "Country", "name": "India" },
  ...(hasDetail && detail.audience ? { "audience": { "@type": "BusinessAudience", "audienceType": detail.audience } } : {}),
  "url": canonicalUrl,
  "category": cat.title,
};

// Article schema - emitted only for flagship (hand-authored) cert pages.
// datePublished: when the flagship detail content first shipped (2026-05-05).
// dateModified:  bump this when content is updated; freshness signal for Google.
const CERT_PUBLISHED = "2026-05-05";
const CERT_MODIFIED  = "2026-05-18";

const articleLd = hasDetail ? {
  "@context": "https://schema.org",
  "@type": "Article",
  "@id": `${canonicalUrl}#article`,
  "headline": `${standard.code} - ${standard.name}`,
  "description": metaDescription,
  "author":     { "@id": "https://www.qualitynexus.in/#organization" },
  "publisher":  { "@id": "https://www.qualitynexus.in/#organization" },
  "datePublished": CERT_PUBLISHED,
  "dateModified":  CERT_MODIFIED,
  "mainEntityOfPage": canonicalUrl,
  "image": "https://www.qualitynexus.in/og/default.jpg",
  "about": [
    { "@type": "Thing", "name": standard.code },
    { "@type": "Thing", "name": standard.name },
    { "@type": "Thing", "name": cat.title },
  ],
  "inLanguage": "en-IN",
} : null;
---
<BaseLayout
  title={`${standard.code} - ${standard.name} | QualityNexus`}
  description={metaDescription}
  noindex={!hasDetail}
>
  <script type="application/ld+json" slot="head" set:html={JSON.stringify(breadcrumbLd)} />
  <script type="application/ld+json" slot="head" set:html={JSON.stringify(serviceLd)} />
  {articleLd && (
    <script type="application/ld+json" slot="head" set:html={JSON.stringify(articleLd)} />
  )}
  <!-- ========== HERO ========== -->
  <section class="cert-hero">
    <div class="cert-hero-bg" aria-hidden="true">
      <span class="cert-hero-glow cert-hero-glow--a"></span>
      <span class="cert-hero-glow cert-hero-glow--b"></span>
    </div>
    <div class="container">
      <nav class="cert-crumb" aria-label="Breadcrumb">
        <a href="/">Home</a>
        <span aria-hidden="true">›</span>
        <a href="/certifications/">Certifications</a>
        <span aria-hidden="true">›</span>
        <a href={`/certifications/#${cat.id}`}>{cat.title}</a>
        <span aria-hidden="true">›</span>
        <span class="cert-crumb-current">{standard.code}</span>
      </nav>

      <div class="cert-hero-grid">
        <div class="cert-hero-text">
          <span class="eyebrow">{cat.title}</span>
          <h1>
            <span class="cert-hero-code">{standard.code}</span>
            <span class="cert-hero-name">{standard.name}</span>
          </h1>
          {hasDetail
            ? <p class="cert-hero-lede">{detail.intro}</p>
            : <p class="cert-hero-lede">QualityNexus supports {standard.code} ({standard.name}) end-to-end - gap analysis, documentation, internal audit, certification audit support, and post-certification surveillance. Contact us for a tailored scope discussion.</p>
          }
          <div class="cert-hero-actions">
            <a href="/contact/" class="btn btn-accent">Talk to a senior consultant</a>
            <a href="/certifications/" class="btn btn-ghost">Back to all standards</a>
          </div>
          {pillar && (
            <a href={pillar.href} class="cert-pillar-link">
              <Icon name="file-text" />
              <span>{pillar.label}</span>
              <Icon name="arrow-right" />
            </a>
          )}
        </div>

        <aside class="cert-hero-card">
          <div class="cert-hero-card-seal" aria-hidden="true">
            <Icon name={cat.icon} />
          </div>
          <span class="cert-hero-card-eyebrow">Standard</span>
          <strong class="cert-hero-card-code">{standard.code}</strong>
          <span class="cert-hero-card-name">{standard.name}</span>
          <ul class="cert-hero-card-meta">
            <li><span>Category</span><strong>{cat.title}</strong></li>
            <li><span>Engagement</span><strong>6–12 weeks typical</strong></li>
            <li><span>Validity</span><strong>3 years (annual surveillance)</strong></li>
          </ul>
        </aside>
      </div>
    </div>
  </section>

  {hasDetail ? (
    <>
      <!-- ========== KEY PRINCIPLES ========== -->
      <section class="section section-soft">
        <div class="container">
          <div class="section-head">
            <span class="eyebrow">Key principles</span>
            <h2>What {standard.code} actually requires.</h2>
            <p>The core disciplines you will operationalize when implementing this standard.</p>
          </div>
          <ul class="principles-list">
            {detail.principles.map((p) => (
              <li>
                <span class="principles-mark" aria-hidden="true">
                  <Icon name="check-circle" />
                </span>
                <span>{p}</span>
              </li>
            ))}
          </ul>
        </div>
      </section>

      <!-- ========== WHY IT MATTERS ========== -->
      <section class="section">
        <div class="container">
          <div class="section-head">
            <span class="eyebrow">Why it matters</span>
            <h2>What {standard.code} unlocks.</h2>
            <p>The reasons organizations actually pursue this certification - beyond the badge on the website.</p>
          </div>
          <div class="why-grid">
            {detail.why.map((w, i) => (
              <article class="why-card">
                <span class="why-icon" aria-hidden="true">
                  <Icon name={whyIcons[i % whyIcons.length]} />
                </span>
                <h3>{w.title}</h3>
                <p>{w.body}</p>
              </article>
            ))}
          </div>
        </div>
      </section>

      <!-- ========== BENEFITS ========== -->
      <section class="section section-soft">
        <div class="container">
          <div class="section-head">
            <span class="eyebrow">Benefits</span>
            <h2>Where the value lands.</h2>
            <p>Concrete outcomes for the four audiences inside any organization.</p>
          </div>
          <div class="benefits-grid">
            {detail.benefits.map((b, i) => (
              <article class="benefit-card">
                <span class="benefit-icon" aria-hidden="true">
                  <Icon name={benefitIcons[i % benefitIcons.length]} />
                </span>
                <h3>{b.title}</h3>
                <p>{b.body}</p>
              </article>
            ))}
          </div>
        </div>
      </section>

      <!-- ========== WHO CAN BENEFIT ========== -->
      <section class="section">
        <div class="container">
          <div class="audience-card">
            <div>
              <span class="eyebrow">Who can benefit</span>
              <h2>Is {standard.code} relevant for you?</h2>
              <p>{detail.audience}</p>
            </div>
            <a href="/contact/" class="btn btn-accent audience-cta">Get a fit assessment</a>
          </div>
        </div>
      </section>
    </>
  ) : (
    <!-- ========== FALLBACK FOR UN-AUTHORED STANDARDS ========== -->
    <section class="section">
      <div class="container">
        <div class="stub-card">
          <span class="eyebrow">Detailed reference in progress</span>
          <h2>We're preparing a full reference for {standard.code}.</h2>
          <p>In the meantime, we already consult, train, implement, and audit against {standard.code} - the structured page is on its way. For a scope discussion specific to your organization, reach out and a senior consultant will respond within 48 hours.</p>
          <div class="stub-bullets">
            <div>
              <span class="stub-bullet-icon" aria-hidden="true"><Icon name="check-circle" /></span>
              <strong>Gap analysis</strong>
              <span>Where you stand against the current revision of the standard.</span>
            </div>
            <div>
              <span class="stub-bullet-icon" aria-hidden="true"><Icon name="check-circle" /></span>
              <strong>Implementation roadmap</strong>
              <span>Documentation, controls, and training scoped to your size and sector.</span>
            </div>
            <div>
              <span class="stub-bullet-icon" aria-hidden="true"><Icon name="check-circle" /></span>
              <strong>Audit support</strong>
              <span>Internal audit + certification body coordination through to the certificate.</span>
            </div>
          </div>
          <div class="stub-actions">
            <a href="/contact/" class="btn btn-accent">Talk to a senior consultant</a>
            <a href="/certifications/" class="btn btn-ghost">See all standards</a>
          </div>
        </div>
      </div>
    </section>
  )}

  <CtaStrip
    heading={`Ready to scope a ${standard.code} engagement?`}
    body="Tell us your starting point, your timeline, and the gaps you already know about. We come back within 48 hours with an honest read on whether we're a fit."
    ctaLabel="Start a conversation"
    source={`cert-${standard.slug}`}
  />
</BaseLayout>

<style>
  /* ========== HERO ========== */
  .cert-hero {
    position: relative;
    padding: 56px 0 64px;
    overflow: hidden;
    isolation: isolate;
    background: linear-gradient(180deg, #FFFFFF 0%, #F8FAFC 100%);
  }
  .cert-hero-bg {
    position: absolute; inset: 0;
    pointer-events: none;
    z-index: -1;
  }
  .cert-hero-glow {
    position: absolute;
    width: 520px; height: 520px;
    border-radius: 50%;
    filter: blur(110px);
    opacity: 0.45;
  }
  .cert-hero-glow--a {
    top: -180px; right: -120px;
    background: radial-gradient(closest-side, rgba(212, 175, 55, 0.30), transparent);
  }
  .cert-hero-glow--b {
    bottom: -200px; left: -120px;
    background: radial-gradient(closest-side, rgba(16, 185, 129, 0.25), transparent);
  }
  .cert-crumb {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
    align-items: center;
    color: var(--color-text-muted);
    font-size: 13px;
    margin-bottom: 22px;
  }
  .cert-crumb a {
    color: var(--color-text-muted);
    transition: color .15s ease;
  }
  .cert-crumb a:hover { color: var(--color-accent-strong); }
  .cert-crumb-current {
    color: var(--color-heading);
    font-weight: 600;
  }
  .cert-hero-grid {
    display: grid;
    grid-template-columns: 1.5fr 1fr;
    gap: 48px;
    align-items: start;
  }
  .cert-hero-text h1 {
    margin: 12px 0 18px;
    line-height: 1.05;
    letter-spacing: -0.02em;
  }
  .cert-hero-code {
    display: block;
    font-size: clamp(34px, 4vw, 48px);
    background: linear-gradient(120deg, #E8C766 0%, var(--color-gold) 50%, #F4D580 100%);
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
    background-clip: text;
    margin-bottom: 6px;
  }
  .cert-hero-name {
    display: block;
    font-size: clamp(28px, 3.4vw, 38px);
    color: var(--color-heading);
  }
  .cert-hero-lede {
    color: var(--color-text);
    font-size: 17px;
    line-height: 1.65;
    max-width: 620px;
    margin-bottom: 24px;
  }
  .cert-hero-actions {
    display: flex;
    gap: 12px;
    flex-wrap: wrap;
  }
  .cert-pillar-link {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    margin-top: 18px;
    padding: 10px 16px;
    background: rgba(212, 175, 55, 0.10);
    border: 1px solid rgba(212, 175, 55, 0.35);
    border-radius: 10px;
    color: var(--color-heading);
    text-decoration: none;
    font-size: 14px;
    font-weight: 600;
    transition: background .2s ease, border-color .2s ease, transform .2s ease;
  }
  .cert-pillar-link:hover {
    background: rgba(212, 175, 55, 0.18);
    border-color: var(--color-gold);
    transform: translateY(-1px);
  }
  .cert-pillar-link :global(svg) {
    width: 16px;
    height: 16px;
    color: var(--color-gold-strong);
    flex-shrink: 0;
  }

  .cert-hero-card {
    position: relative;
    background: var(--color-bg);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-lg);
    padding: 28px 26px 22px;
    box-shadow: var(--shadow-md);
    display: flex;
    flex-direction: column;
    gap: 4px;
  }
  .cert-hero-card-seal {
    position: absolute;
    top: -22px; right: 22px;
    width: 56px; height: 56px;
    border-radius: 14px;
    background: linear-gradient(135deg, var(--color-primary), var(--color-primary-soft));
    color: var(--color-gold);
    display: grid; place-items: center;
    box-shadow: var(--shadow-md);
  }
  .cert-hero-card-seal :global(svg) {
    width: 26px; height: 26px;
  }
  .cert-hero-card-eyebrow {
    color: var(--color-accent-strong);
    font-size: 12px;
    font-weight: 700;
    letter-spacing: 0.1em;
    text-transform: uppercase;
  }
  .cert-hero-card-code {
    color: var(--color-heading);
    font-size: 24px;
    font-weight: 800;
    letter-spacing: -0.01em;
  }
  .cert-hero-card-name {
    color: var(--color-text);
    font-size: 14px;
    margin-bottom: 16px;
  }
  .cert-hero-card-meta {
    display: grid;
    gap: 10px;
    border-top: 1px dashed var(--color-border);
    padding-top: 16px;
  }
  .cert-hero-card-meta li {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    gap: 12px;
    font-size: 13px;
  }
  .cert-hero-card-meta li span {
    color: var(--color-text-muted);
  }
  .cert-hero-card-meta li strong {
    color: var(--color-heading);
    font-weight: 700;
    text-align: right;
  }

  /* ========== PRINCIPLES ========== */
  .principles-list {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 14px;
  }
  .principles-list li {
    display: flex;
    gap: 14px;
    align-items: flex-start;
    padding: 18px 20px;
    border: 1px solid var(--color-border);
    background: var(--color-bg);
    border-radius: var(--radius-md);
    color: var(--color-text);
    font-size: 15px;
    line-height: 1.55;
  }
  .principles-mark {
    flex: 0 0 auto;
    width: 28px; height: 28px;
    border-radius: 8px;
    background: var(--color-accent-soft);
    color: var(--color-accent-strong);
    display: grid; place-items: center;
  }
  .principles-mark :global(svg) { width: 16px; height: 16px; }

  /* ========== WHY IT MATTERS ========== */
  .why-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 18px;
  }
  .why-card {
    background: var(--color-bg);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-lg);
    padding: 24px 22px 22px;
    transition: transform .2s ease, box-shadow .2s ease, border-color .2s ease;
  }
  .why-card:hover {
    transform: translateY(-3px);
    box-shadow: var(--shadow-md);
    border-color: rgba(16, 185, 129, 0.32);
  }
  .why-icon {
    width: 40px; height: 40px;
    border-radius: 10px;
    background: var(--color-accent-soft);
    color: var(--color-accent-strong);
    display: grid; place-items: center;
    margin-bottom: 14px;
  }
  .why-icon :global(svg) { width: 20px; height: 20px; }
  .why-card h3 {
    color: var(--color-heading);
    font-size: 17px;
    font-weight: 700;
    margin-bottom: 6px;
  }
  .why-card p {
    color: var(--color-text);
    font-size: 14px;
    line-height: 1.6;
  }

  /* ========== BENEFITS ========== */
  .benefits-grid {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 18px;
  }
  .benefit-card {
    background: var(--color-bg);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-lg);
    padding: 24px 20px;
    text-align: left;
    transition: transform .2s ease, box-shadow .2s ease;
  }
  .benefit-card:hover {
    transform: translateY(-3px);
    box-shadow: var(--shadow-md);
  }
  .benefit-icon {
    width: 44px; height: 44px;
    border-radius: 10px;
    background: linear-gradient(135deg, var(--color-primary), var(--color-primary-soft));
    color: var(--color-gold);
    display: grid; place-items: center;
    margin-bottom: 14px;
  }
  .benefit-icon :global(svg) { width: 22px; height: 22px; }
  .benefit-card h3 {
    color: var(--color-heading);
    font-size: 16px;
    font-weight: 700;
    margin-bottom: 6px;
  }
  .benefit-card p {
    color: var(--color-text);
    font-size: 14px;
    line-height: 1.6;
  }

  /* ========== WHO CAN BENEFIT ========== */
  .audience-card {
    display: grid;
    grid-template-columns: 1.6fr auto;
    gap: 36px;
    align-items: center;
    padding: 36px 38px;
    background: linear-gradient(135deg, var(--color-primary) 0%, var(--color-primary-soft) 100%);
    color: #fff;
    border-radius: var(--radius-lg);
  }
  .audience-card .eyebrow {
    color: var(--color-gold);
  }
  .audience-card h2 {
    color: #fff;
    margin: 8px 0 14px;
  }
  .audience-card p {
    color: rgba(255, 255, 255, 0.85);
    font-size: 16px;
    line-height: 1.65;
  }
  .audience-cta {
    white-space: nowrap;
  }

  /* ========== STUB (un-authored) ========== */
  .stub-card {
    background: var(--color-bg);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-lg);
    padding: 44px 40px;
    box-shadow: var(--shadow-sm);
    max-width: 880px;
    margin: 0 auto;
  }
  .stub-card h2 {
    margin: 8px 0 14px;
  }
  .stub-card > p {
    color: var(--color-text);
    font-size: 16px;
    line-height: 1.65;
    margin-bottom: 28px;
    max-width: 720px;
  }
  .stub-bullets {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 18px;
    margin-bottom: 30px;
  }
  .stub-bullets > div {
    padding: 18px 20px;
    border: 1px solid var(--color-border);
    border-radius: var(--radius-md);
    background: var(--color-bg-soft);
  }
  .stub-bullet-icon {
    display: inline-grid; place-items: center;
    width: 28px; height: 28px;
    border-radius: 8px;
    background: var(--color-accent-soft);
    color: var(--color-accent-strong);
    margin-bottom: 10px;
  }
  .stub-bullet-icon :global(svg) { width: 16px; height: 16px; }
  .stub-bullets strong {
    display: block;
    color: var(--color-heading);
    font-size: 15px;
    font-weight: 700;
    margin-bottom: 4px;
  }
  .stub-bullets > div span:not(.stub-bullet-icon) {
    color: var(--color-text);
    font-size: 14px;
    line-height: 1.55;
  }
  .stub-actions {
    display: flex;
    gap: 12px;
    flex-wrap: wrap;
  }

  /* ========== RESPONSIVE ========== */
  @media (max-width: 980px) {
    .cert-hero-grid { grid-template-columns: 1fr; }
    .cert-hero-card { max-width: 420px; }
    .why-grid { grid-template-columns: repeat(2, 1fr); }
    .benefits-grid { grid-template-columns: repeat(2, 1fr); }
    .audience-card { grid-template-columns: 1fr; gap: 22px; }
    .stub-bullets { grid-template-columns: 1fr; }
  }
  @media (max-width: 640px) {
    .principles-list { grid-template-columns: 1fr; }
    .why-grid { grid-template-columns: 1fr; }
    .benefits-grid { grid-template-columns: 1fr; }
    .stub-card { padding: 32px 22px; }
  }
</style>
