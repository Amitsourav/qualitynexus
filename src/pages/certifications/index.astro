---
import BaseLayout from "../../layouts/BaseLayout.astro";
import PageHero from "../../components/PageHero.astro";
import CtaStrip from "../../components/CtaStrip.astro";
import Icon from "../../components/Icon.astro";
import { categories, slugify, totalStandards } from "../../data/certifications";
import { breadcrumbLd } from "../../lib/schema";

const crumbs = breadcrumbLd([
  { name: "Home",           href: "/" },
  { name: "Certifications", href: "/certifications/" },
]);
---
<BaseLayout
  title="Certifications — 100+ International Standards"
  description="QualityNexus supports 100+ international standards across quality, security, environment, health & safety, food, medical, AI, and risk management. Browse the full directory."
>
  <script type="application/ld+json" slot="head" set:html={JSON.stringify(crumbs)} />
  <PageHero
    eyebrow="Certifications directory"
    title="100+ international standards."
    accent="Pick yours."
    lede="A complete directory of the standards we consult, train, implement, and audit against. Grouped by domain so you can find yours quickly — and contact us with the ones you don't see listed."
    hasVisual={true}
  >
    <div slot="visual" class="certs-visual">
      <div class="cv-stack">
        <div class="cv-cert cv-cert--3">
          <span class="cv-cert-badge">5S</span>
          <span class="cv-cert-name">Workplace Organization</span>
          <span class="cv-cert-seal" aria-hidden="true">
            <Icon name="clipboard-check" />
          </span>
        </div>
        <div class="cv-cert cv-cert--2">
          <span class="cv-cert-badge">ISO 27001</span>
          <span class="cv-cert-name">Information Security</span>
          <span class="cv-cert-seal" aria-hidden="true">
            <Icon name="lock" />
          </span>
        </div>
        <div class="cv-cert cv-cert--1">
          <span class="cv-cert-eyebrow">Certified</span>
          <span class="cv-cert-badge">ISO 9001</span>
          <span class="cv-cert-name">Quality Management Systems</span>
          <div class="cv-cert-meta">
            <span><strong>2026</strong>Issued</span>
            <span><strong>3 yr</strong>Validity</span>
          </div>
          <span class="cv-cert-seal" aria-hidden="true">
            <Icon name="award" />
          </span>
        </div>
      </div>

      <div class="cv-float-pill cv-float-pill--top">
        <Icon name="check-circle" />
        Stage 2 audit · Passed
      </div>
      <div class="cv-float-pill cv-float-pill--bottom">
        <span class="cv-pulse" aria-hidden="true"><span></span></span>
        100+ standards covered
      </div>
    </div>
  </PageHero>

  <!-- ========== CATEGORY NAV ========== -->
  <section class="cat-nav-section">
    <div class="container">
      <div class="cat-nav-bar">
        <span class="cat-nav-label">{totalStandards} standards · {categories.length} categories</span>
        <ul class="cat-nav-links">
          {categories.map((c) => (
            <li><a href={`#${c.id}`}>{c.title}</a></li>
          ))}
        </ul>
      </div>
    </div>
  </section>

  <!-- ========== CATEGORY SECTIONS ========== -->
  {categories.map((c, i) => (
    <section id={c.id} class={`section ${i % 2 === 1 ? "section-soft" : ""}`}>
      <div class="container">
        <div class="cat-head">
          <span class="cat-icon"><Icon name={c.icon} /></span>
          <div class="cat-text">
            <span class="eyebrow">Category {String(i + 1).padStart(2, "0")}</span>
            <h2>{c.title}</h2>
            <p>{c.blurb}</p>
          </div>
        </div>
        <div class="cert-grid">
          {c.standards.map((s) => (
            <a href={`/certifications/${slugify(s.code)}`} class="cert-card">
              <span class="cert-code">{s.code}</span>
              <span class="cert-name">{s.name}</span>
              <span class="cert-arrow"><Icon name="arrow-right" /></span>
            </a>
          ))}
        </div>
      </div>
    </section>
  ))}

  <CtaStrip
    heading="Don't see your standard?"
    body="We've supported certifications outside this list — country-specific marks, sectoral schemes, and emerging frameworks. Tell us what you're targeting."
    ctaLabel="Talk to a senior consultant"
    source="certs-listing"
  />
</BaseLayout>

<style>
  /* Sticky category nav */
  .cat-nav-section {
    position: sticky;
    top: 64px;
    z-index: 30;
    background: rgba(255,255,255,0.92);
    backdrop-filter: saturate(140%) blur(8px);
    -webkit-backdrop-filter: saturate(140%) blur(8px);
    border-bottom: 1px solid var(--color-border);
    padding: 14px 0;
  }
  .cat-nav-bar {
    display: flex;
    align-items: center;
    gap: 18px;
    flex-wrap: wrap;
  }
  .cat-nav-label {
    font-size: 12.5px;
    font-weight: 700;
    color: var(--color-accent-strong);
    letter-spacing: 0.06em;
    text-transform: uppercase;
    padding-right: 18px;
    border-right: 1px solid var(--color-border);
    flex-shrink: 0;
  }
  .cat-nav-links {
    display: flex;
    gap: 4px 18px;
    flex-wrap: wrap;
  }
  .cat-nav-links a {
    color: var(--color-text);
    font-size: 13.5px;
    font-weight: 500;
    transition: color .15s ease;
  }
  .cat-nav-links a:hover { color: var(--color-accent-strong); }

  /* Category head */
  .cat-head {
    display: flex;
    gap: 24px;
    align-items: flex-start;
    margin-bottom: 40px;
    max-width: 820px;
  }
  .cat-icon {
    display: inline-grid;
    place-items: center;
    width: 56px; height: 56px;
    border-radius: 14px;
    background: var(--color-accent-soft);
    color: var(--color-accent-strong);
    font-size: 24px;
    flex-shrink: 0;
  }
  .cat-text { flex: 1; }
  .cat-text h2 { margin: 12px 0 12px; }
  .cat-text p {
    color: var(--color-text);
    font-size: 16px;
    line-height: 1.65;
  }

  /* Certificate grid */
  .cert-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 14px;
  }
  .cert-card {
    display: grid;
    grid-template-columns: auto 1fr auto;
    align-items: center;
    gap: 14px;
    padding: 18px 20px;
    background: var(--color-bg);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-md);
    color: inherit;
    transition: border-color .2s ease, transform .2s ease, box-shadow .2s ease;
  }
  .cert-card:hover {
    border-color: var(--color-accent);
    transform: translateY(-2px);
    box-shadow: var(--shadow-sm);
    color: inherit;
  }
  .cert-code {
    font-family: var(--font-heading);
    font-weight: 800;
    font-size: 14.5px;
    color: var(--color-heading);
    background: var(--color-bg-section);
    padding: 6px 10px;
    border-radius: 6px;
    letter-spacing: -0.01em;
    white-space: nowrap;
  }
  .cert-name {
    font-size: 13.5px;
    color: var(--color-text);
    line-height: 1.4;
  }
  .cert-arrow {
    color: var(--color-accent);
    font-size: 16px;
    opacity: 0.5;
    transition: opacity .2s ease, transform .2s ease;
  }
  .cert-card:hover .cert-arrow {
    opacity: 1;
    transform: translateX(2px);
  }

  /* ===== HERO VISUAL — certificate stack ===== */
  .certs-visual {
    position: relative;
    width: 100%;
    max-width: 460px;
    height: 480px;
    margin-left: auto;
  }
  .cv-stack {
    position: absolute;
    top: 50%; left: 50%;
    transform: translate(-50%, -50%);
    width: 100%;
    height: 100%;
  }
  .cv-cert {
    position: absolute;
    background: #fff;
    border: 1px solid var(--color-border);
    border-radius: var(--radius-lg);
    padding: 22px 22px 20px;
    box-shadow: var(--shadow-md);
    width: 320px;
    max-width: 92%;
  }
  .cv-cert--1 {
    top: 14%;
    left: 50%;
    transform: translateX(-50%) rotate(-2deg);
    z-index: 3;
    padding: 26px 26px 24px;
    background: linear-gradient(180deg, #F4FBF8 0%, #FFFFFF 100%);
    border-color: rgba(16, 185, 129, 0.36);
    box-shadow: 0 18px 50px rgba(15, 59, 46, 0.18), inset 0 0 0 4px rgba(16, 185, 129, 0.08);
    animation: cvFloat1 8s ease-in-out infinite;
  }
  .cv-cert--2 {
    top: 4%;
    left: 4%;
    transform: rotate(-7deg);
    z-index: 2;
    width: 220px;
    animation: cvFloat2 9s ease-in-out infinite;
  }
  .cv-cert--3 {
    bottom: 6%;
    right: 0;
    transform: rotate(5deg);
    z-index: 1;
    width: 220px;
    animation: cvFloat3 9.5s ease-in-out infinite;
  }
  @keyframes cvFloat1 {
    0%, 100% { transform: translateX(-50%) rotate(-2deg) translateY(0); }
    50%      { transform: translateX(-50%) rotate(-2deg) translateY(-6px); }
  }
  @keyframes cvFloat2 {
    0%, 100% { transform: rotate(-7deg) translateY(0); }
    50%      { transform: rotate(-7deg) translateY(-5px); }
  }
  @keyframes cvFloat3 {
    0%, 100% { transform: rotate(5deg) translateY(0); }
    50%      { transform: rotate(5deg) translateY(-5px); }
  }
  .cv-cert-eyebrow {
    display: block;
    font-size: 10.5px;
    font-weight: 800;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    color: var(--color-accent-strong);
    margin-bottom: 8px;
  }
  .cv-cert-badge {
    display: block;
    font-family: var(--font-heading);
    font-size: 22px;
    font-weight: 800;
    color: var(--color-heading);
    letter-spacing: -0.02em;
    margin-bottom: 4px;
  }
  .cv-cert--2 .cv-cert-badge,
  .cv-cert--3 .cv-cert-badge {
    font-size: 16px;
  }
  .cv-cert-name {
    display: block;
    color: var(--color-text);
    font-size: 13px;
    font-weight: 500;
    line-height: 1.4;
  }
  .cv-cert--1 .cv-cert-name { font-size: 13.5px; margin-bottom: 18px; }
  .cv-cert-meta {
    display: flex;
    gap: 16px;
    border-top: 1px solid rgba(16,185,129,0.22);
    padding-top: 12px;
    margin-top: 8px;
  }
  .cv-cert-meta span {
    display: flex;
    flex-direction: column;
    font-size: 10.5px;
    color: var(--color-text-muted);
    letter-spacing: 0.04em;
    text-transform: uppercase;
  }
  .cv-cert-meta strong {
    font-family: var(--font-heading);
    font-size: 14px;
    font-weight: 800;
    color: var(--color-heading);
    letter-spacing: -0.01em;
    text-transform: none;
    margin-bottom: 1px;
  }
  .cv-cert-seal {
    position: absolute;
    top: 16px;
    right: 18px;
    display: inline-grid;
    place-items: center;
    width: 36px; height: 36px;
    border-radius: 50%;
    background: var(--color-primary);
    color: var(--color-gold);
    font-size: 16px;
    box-shadow: 0 4px 12px rgba(15, 59, 46, 0.25);
  }
  .cv-cert--2 .cv-cert-seal,
  .cv-cert--3 .cv-cert-seal {
    width: 28px; height: 28px;
    font-size: 13px;
  }

  .cv-float-pill {
    position: absolute;
    background: #fff;
    border: 1px solid var(--color-border);
    border-radius: 999px;
    padding: 8px 14px;
    font-size: 12px;
    font-weight: 600;
    color: var(--color-heading);
    display: inline-flex;
    align-items: center;
    gap: 8px;
    box-shadow: var(--shadow-md);
    z-index: 5;
    white-space: nowrap;
  }
  .cv-float-pill--top { top: 0; right: 4%; }
  .cv-float-pill--bottom { bottom: -4px; left: 4%; }
  .cv-float-pill :global(.qn-icon) { color: var(--color-accent); font-size: 14px; }
  .cv-pulse { position: relative; width: 8px; height: 8px; }
  .cv-pulse > span {
    position: absolute;
    inset: 0;
    border-radius: 50%;
    background: var(--color-accent);
    box-shadow: 0 0 0 0 rgba(16,185,129,0.6);
    animation: cvPulse 2.4s ease-out infinite;
  }
  @keyframes cvPulse {
    0%   { box-shadow: 0 0 0 0 rgba(16,185,129,0.55); }
    70%  { box-shadow: 0 0 0 10px rgba(16,185,129,0); }
    100% { box-shadow: 0 0 0 0 rgba(16,185,129,0); }
  }

  @media (max-width: 980px) {
    .cert-grid { grid-template-columns: repeat(2, 1fr); }
    .cat-nav-section { position: static; }
    .certs-visual { margin: 0 auto; }
  }
  @media (max-width: 640px) {
    .cert-grid { grid-template-columns: 1fr; }
    .cat-head { gap: 16px; flex-direction: column; }
    .certs-visual { height: 420px; max-width: 380px; }
    .cv-cert { width: 280px; }
    .cv-cert--2, .cv-cert--3 { width: 200px; }
  }
</style>
