---
import BaseLayout from "../layouts/BaseLayout.astro";
import HeroVisual from "../components/HeroVisual.astro";
import Icon from "../components/Icon.astro";
import CtaStrip from "../components/CtaStrip.astro";

const coreServices = [
  {
    icon: "award",
    title: "ISO Consultancy",
    bullets: ["ISO 9001", "ISO 14001", "ISO 45001", "ISO 27001", "ISO 50001", "ISO 37001"],
  },
  {
    icon: "stethoscope",
    title: "NABL Consultancy",
    bullets: ["ISO/IEC 17025", "Laboratory Documentation", "Internal Audit", "Technical Implementation Support"],
  },
  {
    icon: "lock",
    title: "IT Security & Cyber Security Services",
    bullets: ["IT Security Audit", "VAPT Coordination", "Cyber Security Compliance Support", "ISO 27001 Implementation", "Risk Assessment", "Information Security Documentation"],
  },
  {
    icon: "cog",
    title: "Management Systems & Audits",
    bullets: ["5S Management System", "Water Audit", "External Health & Safety Audit", "Process Improvement Audit", "Workplace Management System"],
  },
  {
    icon: "file-text",
    title: "Audit, Documentation & Compliance",
    bullets: ["Internal Audit", "Compliance Audit", "SOP Preparation", "Process Documentation", "Risk Assessment", "Compliance Support", "Regulatory Documentation"],
  },
  {
    icon: "graduation-cap",
    title: "Training & Capacity Building",
    bullets: ["Lead Auditor Training", "Awareness Training", "Compliance Training", "Industrial Safety Training", "Capacity Building Programs"],
  },
];

const whyChooseUs = [
  { logo: "/images/why-icons/consultants.svg", logoAlt: "Team of consultants",          title: "Experienced Industry Consultants",   body: "Senior consultants with sector-specific backgrounds across power, manufacturing, BFSI, healthcare, and labs.",  image: "/images/team-meeting.jpg",  imageAlt: "Senior consultants in a working meeting" },
  { logo: "/images/why-icons/compliance.svg",  logoAlt: "Compliance shield with check", title: "End-to-End Compliance Support",      body: "Gap analysis to certificate, plus surveillance and re-certification - one accountable partner.",            image: "/images/team-collab.jpg",   imageAlt: "Team collaborating on a compliance engagement" },
  { logo: "/images/why-icons/india.svg",       logoAlt: "Map of India",                 title: "PAN India Services",                 body: "Consultants travel on-site across India - from Ranchi HQ to client sites in any state.",                    image: "/images/office-modern.jpg", imageAlt: "A modern professional office space" },
  { logo: "/images/why-icons/industry.svg",    logoAlt: "Industrial facility",          title: "Industry-Focused Solutions",         body: "PSU, manufacturing, laboratory, and healthcare engagements - sector context, not generic templates.",            image: "/images/events/site-audit.jpg", imageAlt: "On-site industrial audit walk-through" },
];

const recognitions = [
  { label: "Startup India",                  sub: "DIPP recognized",       logo: "/images/badges/startup-india.png", alt: "Startup India" },
  { label: "MSME · Udyam",                   sub: "Govt. of India",        logo: "/images/badges/msme.png",          alt: "MSME Udyam" },
  { label: "IRCA Associated Professionals",  sub: "Lead-auditor certified", logo: "/images/badges/lead-auditor.svg",  alt: "Lead auditor certified seal" },
];

const industries = [
  { logo: "/images/industries/power.svg",              label: "Power Sector" },
  { logo: "/images/industries/laboratories.svg",       label: "Laboratories" },
  { logo: "/images/industries/manufacturing.svg",      label: "Manufacturing" },
  { logo: "/images/industries/engineering.svg",        label: "Engineering" },
  { logo: "/images/industries/healthcare.svg",         label: "Healthcare" },
  { logo: "/images/industries/infrastructure.svg",     label: "Infrastructure" },
  { logo: "/images/industries/government.svg",         label: "Government Organizations" },
  { logo: "/images/industries/railways.svg",           label: "Railways" },
  { logo: "/images/industries/industrial-plants.svg",  label: "Industrial Plants" },
  { logo: "/images/industries/it-service.svg",         label: "IT & Service Sector" },
];

const trustedClients = [
  { name: "NEEPCO",                                logo: "/images/clients/neepco.png",                    abbr: "NEEPCO" },
  { name: "NHPC Limited",                          logo: "/images/clients/nhpc.png" },
  { name: "NTPC Limited",                          logo: "/images/clients/ntpc.png",                      abbr: "NTPC" },
  { name: "Hindustan Aeronautics Ltd",             logo: "/images/clients/hal.jpeg" },
  { name: "Indian Oil Corporation Ltd",            logo: "/images/clients/iocl.png" },
  { name: "GAIL Gas Limited",                      logo: "/images/clients/gail.png" },
  { name: "Numaligarh Refinery Ltd",               logo: "/images/clients/nrl.jpeg" },
  { name: "Hindustan Copper Ltd",                  logo: "/images/clients/hindustan-copper.jpg" },
  { name: "Indian Railways",                       logo: "/images/clients/Indian-Railway.png" },
  { name: "Balmer Lawrie & Co. Ltd",               logo: "/images/clients/balmer-lawrie.jpg" },
  { name: "Duckback (India)",                      logo: "/images/clients/Duckback-India.jpeg" },
  { name: "Exemplar Cordage LLP",                  logo: "/images/clients/EXEMPLAR-CORDAGE-LLP.jpeg" },
  { name: "Jharkhand Rajya Gramin Bank",           logo: "/images/clients/JRGB.jpeg" },
];

// Subset used in the hero marquee (auto-scrolling band)
const clientLogos = trustedClients.filter((c) => c.logo);

// ===== Google reviews (verified, sourced from Google Business Profile) =====
const reviews = [
  {
    name: "Deepak Thakur",
    initial: "D",
    avatarColor: "#10B981",
    rating: 5,
    timeAgo: "a year ago",
    text: "Our experience with Quality Nexus Private Limited for ISO 9001 implementation and certification was excellent. Their team not only guided us step-by-step but also provided professional support at every stage. The quality of documentation, training, and internal audits was of the highest standard, enabling us to achieve ISO 9001 certification smoothly and without any major non-conformities.",
    summary: "ISO 9001 implementation and certification",
  },
  {
    name: "Avanit Manohar Agrawal",
    initial: "A",
    avatarColor: "#DC2626",
    rating: 5,
    timeAgo: "2 months ago",
    isLocalGuide: true,
    text: "Very effective lead auditor training conducted by Sh. Vishwadeep Tiwary Sir. Highly recommend M/s Quality Nexus to other organisations as well.",
    summary: "Lead auditor training",
  },
  {
    name: "Marun Dutta",
    initial: "M",
    avatarColor: "#DB2777",
    rating: 5,
    timeAgo: "2 months ago",
    text: "I would like to sincerely thank Vishwadeep Tiwary Sir of Quality Nexus Pvt Ltd for conducting lead auditor training program of ISO 50001: 2018 energy management system.",
    summary: "ISO 50001 lead auditor training",
  },
  {
    name: "Raj Kumar",
    initial: "R",
    avatarColor: "#0E3B2E",
    rating: 5,
    timeAgo: "2 months ago",
    text: "The company works professionally in ISO and quality-related services. Management is supportive and work is done in a systematic manner. Good exposure to quality systems and audits.",
    summary: "ISO and quality services",
  },
];

const avgRating = (reviews.reduce((s, r) => s + r.rating, 0) / reviews.length).toFixed(1);

const reviewsLd = {
  "@context": "https://schema.org",
  "@type": "Organization",
  "@id": "https://www.qualitynexus.in/#organization",
  "name": "Quality Nexus Private Limited",
  "aggregateRating": {
    "@type": "AggregateRating",
    "ratingValue": avgRating,
    "reviewCount": reviews.length,
    "bestRating": "5",
    "worstRating": "1",
  },
  "review": reviews.map((r) => ({
    "@type": "Review",
    "author": { "@type": "Person", "name": r.name },
    "reviewRating": { "@type": "Rating", "ratingValue": r.rating, "bestRating": 5 },
    "reviewBody": r.text,
  })),
};
---
<BaseLayout
  title="ISO, NABL, IT Security & Compliance Consultancy in India · QualityNexus"
  description="QualityNexus - ISO certification consultancy, NABL implementation, IT security audit, VAPT, 5S, water audit, and compliance training across India. Based in Ranchi."
>
  <script type="application/ld+json" slot="head" set:html={JSON.stringify(reviewsLd)} />

  <!-- ========== HERO ========== -->
  <section class="hero">
    <div class="hero-bg-grid" aria-hidden="true"></div>
    <div class="hero-bg-glow hero-bg-glow--1" aria-hidden="true"></div>
    <div class="hero-bg-glow hero-bg-glow--2" aria-hidden="true"></div>

    <div class="container hero-inner">
      <div class="hero-copy">
        <span class="eyebrow">Quality Nexus Private Limited</span>
        <h1>
          ISO, NABL, IT Security &amp; Compliance<br/>
          <span class="hero-accent">Consultancy Services Across India</span>
        </h1>
        <p class="lede">
          Helping Industries, Laboratories &amp; Organizations Achieve Audit Readiness, Compliance Excellence,
          Process Improvement &amp; Information Security with Confidence.
        </p>
        <div class="hero-ctas">
          <a href="/contact/?utm_source=site&utm_medium=hero-primary&utm_campaign=home" class="btn btn-accent btn-shimmer">
            Get Consultation <Icon name="arrow-right" />
          </a>
          <a href="/contact/?utm_source=site&utm_medium=hero-secondary&utm_campaign=home" class="btn btn-ghost">Contact Us</a>
        </div>
        <div class="hero-stats">
          <div><strong>100+</strong><span>International standards</span></div>
          <div><strong>50+</strong><span>PSU &amp; enterprise clients</span></div>
          <div><strong>12+</strong><span>Years per lead consultant</span></div>
        </div>
      </div>
      <HeroVisual />
    </div>

    <!-- Trusted-by logo carousel: full-width band inside the hero section -->
    <div class="hero-marquee">
      <div class="container hero-marquee-head">
        <span class="eyebrow">Trusted by</span>
        <span class="hero-marquee-sub">Public-sector and enterprise organizations</span>
      </div>
      <div class="marquee" aria-hidden="true">
        <div class="marquee-track">
          {[...clientLogos, ...clientLogos].map((c) => (
            <div class="logo-tile">
              <img src={c.logo} alt={`${c.name} logo`} class="logo-img" loading="lazy" decoding="async" width="160" height="64" />
            </div>
          ))}
        </div>
      </div>
    </div>
  </section>

  <!-- ========== ABOUT BLURB ========== -->
  <section class="section section-soft">
    <div class="container about-blurb">
      <span class="eyebrow">About us</span>
      <h2>About Quality Nexus Private Limited</h2>
      <p>
        Quality Nexus Private Limited is a professional consultancy company based in Ranchi, India, providing
        ISO certification consultancy, NABL implementation support, IT security audits, VAPT coordination,
        5S management system consultancy, health &amp; safety audits, water audits, compliance consulting,
        training, documentation, and business process improvement services across multiple industries.
      </p>
    </div>
  </section>

  <!-- ========== CORE SERVICES (6 CATEGORIES) ========== -->
  <section class="section">
    <div class="container">
      <div class="section-head center">
        <span class="eyebrow">What we deliver</span>
        <h2>Our Core Services</h2>
        <p>End-to-end consultancy, audits, training, and compliance - across the standards and frameworks Indian industries actually need.</p>
      </div>
      <div class="core-services-grid">
        {coreServices.map((s, i) => (
          <article class="core-service-card">
            <span class="core-service-num">{String(i + 1).padStart(2, "0")}</span>
            <span class="icon-halo"><Icon name={s.icon} /></span>
            <h3>{s.title}</h3>
            <ul class="core-service-bullets">
              {s.bullets.map((b) => (
                <li><Icon name="check-circle" /> {b}</li>
              ))}
            </ul>
          </article>
        ))}
      </div>
    </div>
  </section>

  <!-- ========== WHY CHOOSE US ========== -->
  <section class="section section-dark">
    <div class="container">
      <div class="section-head center">
        <span class="eyebrow eyebrow-on-dark">Why us</span>
        <h2>Why Choose Quality Nexus?</h2>
        <p class="why-lede">Four reasons clients keep coming back - and bringing their next certification with us.</p>
      </div>
      <ul class="why-grid">
        {whyChooseUs.map((f) => (
          <li class="why-item">
            <img src={f.image} alt={f.imageAlt} class="why-item-img" loading="lazy" decoding="async" width="600" height="800" />
            <span class="why-item-overlay" aria-hidden="true"></span>
            <span class="feature-icon-halo feature-icon-halo--logo">
              <img src={f.logo} alt={f.logoAlt} loading="lazy" decoding="async" width="40" height="40" />
            </span>
            <div class="why-item-body">
              <h4>{f.title}</h4>
              <p>{f.body}</p>
            </div>
          </li>
        ))}
      </ul>
    </div>
  </section>

  <!-- ========== TRUSTED BY LEADING ORGANIZATIONS ========== -->
  <section class="section section-soft">
    <div class="container">
      <div class="section-head center">
        <span class="eyebrow">Trust</span>
        <h2>Trusted By Leading Organizations</h2>
        <p>Engagements with India's leading public-sector and enterprise organizations - including <strong>NEEPCO</strong>, <strong>NHPC</strong>, <strong>NTPC</strong>, <strong>HAL</strong>, <strong>IOCL</strong>, <strong>GAIL</strong>, <strong>Indian Railways</strong>, and more.</p>
      </div>
      <div class="recognition-row">
        {recognitions.map((r) => (
          <div class="recognition-badge">
            <span class={`recognition-tick recognition-tick--logo ${r.label === "Startup India" ? "recognition-tick--wide" : ""}`}>
              <img src={r.logo} alt={r.alt} loading="lazy" decoding="async" width="40" height="40" />
            </span>
            <div>
              <strong>{r.label}</strong>
              <span>{r.sub}</span>
            </div>
          </div>
        ))}
      </div>
      <div class="trust-cta">
        <a href="/clients/" class="link-arrow">See all featured clients <Icon name="arrow-right" /></a>
        <a href="/psu-vendor-compliance/" class="link-arrow">PSU vendor compliance guide <Icon name="arrow-right" /></a>
      </div>
    </div>
  </section>

  <!-- ========== INDUSTRIES WE SERVE ========== -->
  <section class="section">
    <div class="container">
      <div class="section-head center">
        <span class="eyebrow">Sectors</span>
        <h2>Industries We Serve</h2>
        <p>Engagements led by consultants with sector context - because every standard reads differently across industries.</p>
      </div>
      <ul class="industries-grid">
        {industries.map((i) => (
          <li class="industry-chip">
            <span class="industry-chip-icon industry-chip-icon--logo">
              <img src={i.logo} alt="" loading="lazy" decoding="async" width="32" height="32" />
            </span>
            <span class="industry-chip-label">{i.label}</span>
          </li>
        ))}
      </ul>
    </div>
  </section>

  <!-- ========== CLIENT REVIEWS (verified Google) ========== -->
  <section class="section section-soft reviews-section">
    <div class="container">
      <div class="section-head center">
        <span class="eyebrow">Client reviews</span>
        <h2>What our clients say.</h2>
        <div class="reviews-summary" aria-label={`Rated ${avgRating} out of 5 on Google, ${reviews.length} verified reviews`}>
          <span class="reviews-rating-num">{avgRating}</span>
          <span class="reviews-stars" aria-hidden="true">
            {Array.from({ length: 5 }).map(() => (
              <svg viewBox="0 0 24 24" width="20" height="20" fill="#F5B400"><path d="M12 2l2.92 6.91 7.47.65-5.66 4.93 1.71 7.29L12 17.77l-6.44 3.99 1.71-7.29L1.61 9.56l7.47-.65z"/></svg>
            ))}
          </span>
          <span class="reviews-summary-meta">
            <span>{reviews.length} verified reviews</span>
            <span class="reviews-summary-dot">·</span>
            <span class="reviews-summary-source">
              <svg viewBox="0 0 24 24" width="14" height="14" aria-hidden="true">
                <path fill="#4285F4" d="M22.56 12.25c0-.78-.07-1.53-.2-2.25H12v4.26h5.92c-.26 1.37-1.04 2.53-2.21 3.31v2.77h3.57c2.08-1.92 3.28-4.74 3.28-8.09z"/>
                <path fill="#34A853" d="M12 23c2.97 0 5.46-.98 7.28-2.66l-3.57-2.77c-.98.66-2.23 1.06-3.71 1.06-2.86 0-5.29-1.93-6.16-4.53H2.18v2.84C3.99 20.53 7.7 23 12 23z"/>
                <path fill="#FBBC05" d="M5.84 14.1c-.22-.66-.35-1.36-.35-2.1s.13-1.44.35-2.1V7.07H2.18C1.43 8.55 1 10.22 1 12s.43 3.45 1.18 4.93l2.85-2.22.81-.61z"/>
                <path fill="#EA4335" d="M12 5.38c1.62 0 3.06.56 4.21 1.64l3.15-3.15C17.45 2.09 14.97 1 12 1 7.7 1 3.99 3.47 2.18 7.07l3.66 2.84c.87-2.6 3.3-4.53 6.16-4.53z"/>
              </svg>
              via Google
            </span>
          </span>
        </div>
      </div>

      <div class="reviews-grid">
        {reviews.map((r) => (
          <article class="review-card">
            <header class="review-card-head">
              <span class="review-avatar" style={`background:${r.avatarColor}`} aria-hidden="true">{r.initial}</span>
              <div class="review-meta">
                <strong class="review-name">{r.name}</strong>
                <span class="review-sub">
                  {r.isLocalGuide ? <span class="review-guide">Local Guide</span> : null}
                  <span>{r.timeAgo}</span>
                </span>
              </div>
              <span class="review-source" aria-label="Verified Google review">
                <svg viewBox="0 0 24 24" width="18" height="18" aria-hidden="true">
                  <path fill="#4285F4" d="M22.56 12.25c0-.78-.07-1.53-.2-2.25H12v4.26h5.92c-.26 1.37-1.04 2.53-2.21 3.31v2.77h3.57c2.08-1.92 3.28-4.74 3.28-8.09z"/>
                  <path fill="#34A853" d="M12 23c2.97 0 5.46-.98 7.28-2.66l-3.57-2.77c-.98.66-2.23 1.06-3.71 1.06-2.86 0-5.29-1.93-6.16-4.53H2.18v2.84C3.99 20.53 7.7 23 12 23z"/>
                  <path fill="#FBBC05" d="M5.84 14.1c-.22-.66-.35-1.36-.35-2.1s.13-1.44.35-2.1V7.07H2.18C1.43 8.55 1 10.22 1 12s.43 3.45 1.18 4.93l2.85-2.22.81-.61z"/>
                  <path fill="#EA4335" d="M12 5.38c1.62 0 3.06.56 4.21 1.64l3.15-3.15C17.45 2.09 14.97 1 12 1 7.7 1 3.99 3.47 2.18 7.07l3.66 2.84c.87-2.6 3.3-4.53 6.16-4.53z"/>
                </svg>
              </span>
            </header>

            <div class="review-stars" aria-label={`${r.rating} out of 5 stars`}>
              {Array.from({ length: r.rating }).map(() => (
                <svg viewBox="0 0 24 24" width="15" height="15" fill="#F5B400" aria-hidden="true"><path d="M12 2l2.92 6.91 7.47.65-5.66 4.93 1.71 7.29L12 17.77l-6.44 3.99 1.71-7.29L1.61 9.56l7.47-.65z"/></svg>
              ))}
            </div>

            <p class="review-body">{r.text}</p>

            {r.summary && <span class="review-tag">{r.summary}</span>}
          </article>
        ))}
      </div>
    </div>
  </section>

  <CtaStrip
    heading="Ready to Strengthen Your Compliance & Security System?"
    body="Connect with our experts for ISO, NABL, IT security audit, compliance, 5S implementation, and industrial consultancy services."
    ctaLabel="Request Proposal"
    ctaHref="/contact/"
    secondaryLabel="Talk To Expert"
    secondaryHref="/contact/"
    source="home"
  />
</BaseLayout>

<style>
  /* ========== HERO ========== */
  .hero {
    position: relative;
    padding: 36px 0 28px;
    background: linear-gradient(180deg, #FFFFFF 0%, #F8FAFC 100%);
    overflow: hidden;
    isolation: isolate;
  }
  .hero-bg-grid {
    position: absolute;
    inset: 0;
    z-index: -2;
    background-image:
      linear-gradient(rgba(15,23,42,0.045) 1px, transparent 1px),
      linear-gradient(90deg, rgba(15,23,42,0.045) 1px, transparent 1px);
    background-size: 56px 56px;
    mask-image: radial-gradient(ellipse 80% 70% at 50% 30%, #000 30%, transparent 80%);
    -webkit-mask-image: radial-gradient(ellipse 80% 70% at 50% 30%, #000 30%, transparent 80%);
  }
  .hero-bg-glow {
    position: absolute;
    border-radius: 50%;
    filter: blur(80px);
    z-index: -1;
    pointer-events: none;
  }
  .hero-bg-glow--1 {
    width: 50%; aspect-ratio: 1;
    top: -15%; right: -8%;
    background: radial-gradient(circle, rgba(16,185,129,0.18), transparent 65%);
    animation: heroGlow1 14s ease-in-out infinite alternate;
  }
  .hero-bg-glow--2 {
    width: 40%; aspect-ratio: 1;
    bottom: -20%; left: -10%;
    background: radial-gradient(circle, rgba(15,23,42,0.10), transparent 65%);
    animation: heroGlow2 18s ease-in-out infinite alternate;
  }
  @keyframes heroGlow1 {
    from { transform: translate(0, 0) scale(1); }
    to   { transform: translate(-30px, 20px) scale(1.1); }
  }
  @keyframes heroGlow2 {
    from { transform: translate(0, 0) scale(1); }
    to   { transform: translate(40px, -20px) scale(1.05); }
  }

  .hero-inner {
    display: grid;
    grid-template-columns: 1.05fr 1fr;
    gap: 56px;
    align-items: center;
  }
  .hero-copy h1 {
    margin: 10px 0 14px;
    color: var(--color-heading);
    font-size: clamp(1.85rem, 3.6vw, 2.85rem);
    line-height: 1.08;
    letter-spacing: -0.025em;
    font-weight: 800;
  }
  .hero-accent {
    background: linear-gradient(110deg, #E8C766 0%, #D4AF37 50%, #F4D580 100%);
    background-size: 200% auto;
    -webkit-background-clip: text;
    background-clip: text;
    color: transparent;
    animation: heroShine 6s ease-in-out infinite;
  }
  @keyframes heroShine {
    0%, 100% { background-position: 0% center; }
    50%      { background-position: 100% center; }
  }
  .lede {
    font-size: 17px;
    color: var(--color-text-muted);
    max-width: 580px;
    margin-bottom: 22px;
    line-height: 1.6;
  }
  .hero-ctas {
    display: flex; gap: 12px; flex-wrap: wrap; margin-bottom: 26px;
  }

  .btn-shimmer {
    position: relative;
    overflow: hidden;
    isolation: isolate;
  }
  .btn-shimmer::before {
    content: "";
    position: absolute;
    inset: 0;
    background: linear-gradient(120deg, transparent 30%, rgba(255,255,255,0.45) 50%, transparent 70%);
    transform: translateX(-130%);
    animation: btnShimmer 3.2s ease-in-out infinite;
    pointer-events: none;
  }
  @keyframes btnShimmer {
    0%   { transform: translateX(-130%); }
    50%  { transform: translateX(130%); }
    100% { transform: translateX(130%); }
  }

  .hero-stats {
    display: grid;
    grid-template-columns: repeat(3, auto);
    gap: 32px;
  }
  .hero-stats > div { display: flex; flex-direction: column; }
  .hero-stats strong {
    font-family: var(--font-heading);
    font-size: 26px;
    font-weight: 800;
    color: var(--color-heading);
    line-height: 1;
    margin-bottom: 4px;
    letter-spacing: -0.02em;
  }
  .hero-stats span {
    font-size: 12px;
    color: var(--color-text-muted);
    letter-spacing: 0.02em;
  }

  /* ========== HERO MARQUEE (logo carousel inside hero) ========== */
  .hero-marquee {
    margin-top: 36px;
    padding-top: 24px;
    border-top: 1px solid var(--color-border);
    position: relative;
