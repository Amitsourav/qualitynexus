---
import BaseLayout from "../layouts/BaseLayout.astro";
import HeroVisual from "../components/HeroVisual.astro";
import Icon from "../components/Icon.astro";
import CtaStrip from "../components/CtaStrip.astro";

const coreServices = [
  {
    icon: "award",
    title: "ISO Consultancy",
    bullets: ["ISO 9001", "ISO 14001", "ISO 45001", "ISO 27001", "ISO 50001", "ISO 37001"],
  },
  {
    icon: "stethoscope",
    title: "NABL Consultancy",
    bullets: ["ISO/IEC 17025", "Laboratory Documentation", "Internal Audit", "Technical Implementation Support"],
  },
  {
    icon: "lock",
    title: "IT Security & Cyber Security Services",
    bullets: ["IT Security Audit", "VAPT Coordination", "Cyber Security Compliance Support", "ISO 27001 Implementation", "Risk Assessment", "Information Security Documentation"],
  },
  {
    icon: "cog",
    title: "Management Systems & Audits",
    bullets: ["5S Management System", "Water Audit", "External Health & Safety Audit", "Process Improvement Audit", "Workplace Management System"],
  },
  {
    icon: "file-text",
    title: "Audit, Documentation & Compliance",
    bullets: ["Internal Audit", "Compliance Audit", "SOP Preparation", "Process Documentation", "Risk Assessment", "Compliance Support", "Regulatory Documentation"],
  },
  {
    icon: "graduation-cap",
    title: "Training & Capacity Building",
    bullets: ["Lead Auditor Training", "Awareness Training", "Compliance Training", "Industrial Safety Training", "Capacity Building Programs"],
  },
];

const whyChooseUs = [
  { icon: "users",          title: "Experienced Industry Consultants",     body: "Senior consultants with sector-specific backgrounds across power, manufacturing, BFSI, healthcare, and labs." },
  { icon: "rocket",         title: "Practical Implementation Approach",    body: "We build systems your team will actually use — not 200-page binders that gather dust." },
  { icon: "shield-check",   title: "End-to-End Compliance Support",        body: "Gap analysis to certificate, plus surveillance and re-certification — one accountable partner." },
  { icon: "globe",          title: "PAN India Services",                   body: "Consultants travel on-site across India — from Ranchi HQ to client sites in any state." },
  { icon: "file-text",      title: "Audit-Ready Documentation",            body: "Every artefact survives third-party scrutiny — SOPs, registers, and records aligned to clauses." },
  { icon: "graduation-cap", title: "Professional Training & Guidance",     body: "Lead-auditor and awareness programs delivered by IRCA / Exemplar Global associated professionals." },
  { icon: "compass",        title: "Industry-Focused Solutions",           body: "PSU, manufacturing, lab, healthcare, and IT engagements — sector context, not generic templates." },
  { icon: "lock",           title: "IT Security & Compliance Expertise",   body: "ISO 27001, VAPT coordination, and cybersecurity audits delivered alongside management systems." },
];

const recognitions = [
  { label: "Startup India",                  sub: "DIPP recognized" },
  { label: "MSME · Udyam",                   sub: "Govt. of India" },
  { label: "IRCA Associated Professionals",  sub: "Lead-auditor certified" },
];

const industries = [
  { icon: "zap",          label: "Power Sector" },
  { icon: "stethoscope",  label: "Laboratories" },
  { icon: "cog",          label: "Manufacturing" },
  { icon: "compass",      label: "Engineering" },
  { icon: "shield-check", label: "Healthcare" },
  { icon: "globe",        label: "Infrastructure" },
  { icon: "scale",        label: "Government Organizations" },
  { icon: "rocket",       label: "Railways" },
  { icon: "hard-hat",     label: "Industrial Plants" },
  { icon: "cpu",          label: "IT & Service Sector" },
];

const trustedClients = [
  { name: "NEEPCO",                                logo: null,                                            abbr: "NEEPCO" },
  { name: "NHPC Limited",                          logo: "/images/clients/nhpc.png" },
  { name: "NTPC Limited",                          logo: null,                                            abbr: "NTPC" },
  { name: "Hindustan Aeronautics Ltd",             logo: "/images/clients/hal.jpeg" },
  { name: "Indian Oil Corporation Ltd",            logo: "/images/clients/iocl.png" },
  { name: "GAIL Gas Limited",                      logo: "/images/clients/gail.png" },
  { name: "Numaligarh Refinery Ltd",               logo: "/images/clients/nrl.jpeg" },
  { name: "Hindustan Copper Ltd",                  logo: "/images/clients/hindustan-copper.jpg" },
  { name: "Indian Railways",                       logo: "/images/clients/Indian-Railway.png" },
  { name: "Balmer Lawrie & Co. Ltd",               logo: "/images/clients/balmer-lawrie.jpg" },
  { name: "Duckback (India)",                      logo: "/images/clients/Duckback-India.jpeg" },
  { name: "Exemplar Cordage LLP",                  logo: "/images/clients/EXEMPLAR-CORDAGE-LLP.jpeg" },
  { name: "Jharkhand Rajya Gramin Bank",           logo: "/images/clients/JRGB.jpeg" },
];

// Subset used in the hero marquee (auto-scrolling band)
const clientLogos = trustedClients.filter((c) => c.logo);
---
<BaseLayout
  title="ISO, NABL, IT Security & Compliance Consultancy in India · QualityNexus"
  description="QualityNexus — ISO certification consultancy, NABL implementation, IT security audit, VAPT, 5S, water audit, and compliance training across India. Based in Ranchi."
>
  <!-- ========== HERO ========== -->
  <section class="hero">
    <div class="hero-bg-grid" aria-hidden="true"></div>
    <div class="hero-bg-glow hero-bg-glow--1" aria-hidden="true"></div>
    <div class="hero-bg-glow hero-bg-glow--2" aria-hidden="true"></div>

    <div class="container hero-inner">
      <div class="hero-copy">
        <span class="eyebrow">Quality Nexus Private Limited</span>
        <h1>
          ISO, NABL, IT Security &amp; Compliance<br/>
          <span class="hero-accent">Consultancy Services Across India</span>
        </h1>
        <p class="lede">
          Helping Industries, Laboratories &amp; Organizations achieve audit readiness, compliance excellence,
          process improvement &amp; information security — with confidence.
        </p>
        <div class="hero-ctas">
          <a href="/contact" class="btn btn-accent btn-shimmer">
            Get Consultation <Icon name="arrow-right" />
          </a>
          <a href="/contact" class="btn btn-ghost">Contact Us</a>
        </div>
        <div class="hero-stats">
          <div><strong>100+</strong><span>International standards</span></div>
          <div><strong>50+</strong><span>PSU &amp; enterprise clients</span></div>
          <div><strong>12+</strong><span>Years per lead consultant</span></div>
        </div>
      </div>
      <HeroVisual />
    </div>

    <!-- Trusted-by logo carousel: full-width band inside the hero section -->
    <div class="hero-marquee">
      <div class="container hero-marquee-head">
        <span class="eyebrow">Trusted by</span>
        <span class="hero-marquee-sub">Public-sector and enterprise organizations</span>
      </div>
      <div class="marquee" aria-hidden="true">
        <div class="marquee-track">
          {[...clientLogos, ...clientLogos].map((c) => (
            <div class="logo-tile">
              <img src={c.logo} alt={`${c.name} logo`} class="logo-img" loading="lazy" decoding="async" width="160" height="64" />
            </div>
          ))}
        </div>
      </div>
    </div>
  </section>

  <!-- ========== ABOUT BLURB ========== -->
  <section class="section section-soft">
    <div class="container about-blurb">
      <span class="eyebrow">About us</span>
      <h2>About Quality Nexus Private Limited</h2>
      <p>
        Quality Nexus Private Limited is a professional consultancy company based in Ranchi, India, providing
        ISO certification consultancy, NABL implementation support, IT security audits, VAPT coordination,
        5S management system consultancy, health &amp; safety audits, water audits, compliance consulting,
        training, documentation, and business process improvement services across multiple industries.
      </p>
    </div>
  </section>

  <!-- ========== CORE SERVICES (6 CATEGORIES) ========== -->
  <section class="section">
    <div class="container">
      <div class="section-head center">
        <span class="eyebrow">What we deliver</span>
        <h2>Our Core Services</h2>
        <p>End-to-end consultancy, audits, training, and compliance — across the standards and frameworks Indian industries actually need.</p>
      </div>
      <div class="core-services-grid">
        {coreServices.map((s, i) => (
          <article class="core-service-card">
            <span class="core-service-num">{String(i + 1).padStart(2, "0")}</span>
            <span class="icon-halo"><Icon name={s.icon} /></span>
            <h3>{s.title}</h3>
            <ul class="core-service-bullets">
              {s.bullets.map((b) => (
                <li><Icon name="check-circle" /> {b}</li>
              ))}
            </ul>
          </article>
        ))}
      </div>
    </div>
  </section>

  <!-- ========== WHY CHOOSE US ========== -->
  <section class="section section-dark">
    <div class="container">
      <div class="section-head center">
        <span class="eyebrow eyebrow-on-dark">Why us</span>
        <h2>Why Choose Quality Nexus?</h2>
        <p class="why-lede">Eight reasons clients keep coming back — and bringing their next certification with us.</p>
      </div>
      <ul class="why-grid">
        {whyChooseUs.map((f) => (
          <li class="why-item">
            <span class="feature-icon-halo"><Icon name={f.icon} /></span>
            <div>
              <h4>{f.title}</h4>
              <p>{f.body}</p>
            </div>
          </li>
        ))}
      </ul>
    </div>
  </section>

  <!-- ========== TRUSTED BY LEADING ORGANIZATIONS ========== -->
  <section class="section section-soft">
    <div class="container">
      <div class="section-head center">
        <span class="eyebrow">Trust</span>
        <h2>Trusted By Leading Organizations</h2>
        <p>Engagements with India's leading public-sector and enterprise organizations — including <strong>NEEPCO</strong>, <strong>NHPC</strong>, <strong>NTPC</strong>, <strong>HAL</strong>, <strong>IOCL</strong>, <strong>GAIL</strong>, <strong>Indian Railways</strong>, and more.</p>
      </div>
      <div class="recognition-row">
        {recognitions.map((r) => (
          <div class="recognition-badge">
            <span class="recognition-tick" aria-hidden="true"><Icon name="check-circle" /></span>
            <div>
              <strong>{r.label}</strong>
              <span>{r.sub}</span>
            </div>
          </div>
        ))}
      </div>
      <div class="trust-cta">
        <a href="/clients" class="link-arrow">See all featured clients <Icon name="arrow-right" /></a>
      </div>
    </div>
  </section>

  <!-- ========== INDUSTRIES WE SERVE ========== -->
  <section class="section">
    <div class="container">
      <div class="section-head center">
        <span class="eyebrow">Sectors</span>
        <h2>Industries We Serve</h2>
        <p>Engagements led by consultants with sector context — because every standard reads differently across industries.</p>
      </div>
      <ul class="industries-grid">
        {industries.map((i) => (
          <li class="industry-chip">
            <span class="industry-chip-icon"><Icon name={i.icon} /></span>
            <span class="industry-chip-label">{i.label}</span>
          </li>
        ))}
      </ul>
    </div>
  </section>

  <CtaStrip
    heading="Ready to Strengthen Your Compliance & Security System?"
    body="Connect with our experts for ISO, NABL, IT security audit, compliance, 5S implementation, and industrial consultancy services."
    ctaLabel="Request Proposal"
    ctaHref="/contact"
    secondaryLabel="Talk To Expert"
    secondaryHref="/contact"
  />
</BaseLayout>

<style>
  /* ========== HERO ========== */
  .hero {
    position: relative;
    padding: 36px 0 28px;
    background: linear-gradient(180deg, #FFFFFF 0%, #F8FAFC 100%);
    overflow: hidden;
    isolation: isolate;
  }
  .hero-bg-grid {
    position: absolute;
    inset: 0;
    z-index: -2;
    background-image:
      linear-gradient(rgba(15,23,42,0.045) 1px, transparent 1px),
      linear-gradient(90deg, rgba(15,23,42,0.045) 1px, transparent 1px);
    background-size: 56px 56px;
    mask-image: radial-gradient(ellipse 80% 70% at 50% 30%, #000 30%, transparent 80%);
    -webkit-mask-image: radial-gradient(ellipse 80% 70% at 50% 30%, #000 30%, transparent 80%);
  }
  .hero-bg-glow {
    position: absolute;
    border-radius: 50%;
    filter: blur(80px);
    z-index: -1;
    pointer-events: none;
  }
  .hero-bg-glow--1 {
    width: 50%; aspect-ratio: 1;
    top: -15%; right: -8%;
    background: radial-gradient(circle, rgba(16,185,129,0.18), transparent 65%);
    animation: heroGlow1 14s ease-in-out infinite alternate;
  }
  .hero-bg-glow--2 {
    width: 40%; aspect-ratio: 1;
    bottom: -20%; left: -10%;
    background: radial-gradient(circle, rgba(15,23,42,0.10), transparent 65%);
    animation: heroGlow2 18s ease-in-out infinite alternate;
  }
  @keyframes heroGlow1 {
    from { transform: translate(0, 0) scale(1); }
    to   { transform: translate(-30px, 20px) scale(1.1); }
  }
  @keyframes heroGlow2 {
    from { transform: translate(0, 0) scale(1); }
    to   { transform: translate(40px, -20px) scale(1.05); }
  }

  .hero-inner {
    display: grid;
    grid-template-columns: 1.05fr 1fr;
    gap: 56px;
    align-items: center;
  }
  .hero-copy h1 {
    margin: 10px 0 14px;
    color: var(--color-heading);
    font-size: clamp(1.85rem, 3.6vw, 2.85rem);
    line-height: 1.08;
    letter-spacing: -0.025em;
    font-weight: 800;
  }
  .hero-accent {
    background: linear-gradient(110deg, #E8C766 0%, #D4AF37 50%, #F4D580 100%);
    background-size: 200% auto;
    -webkit-background-clip: text;
    background-clip: text;
    color: transparent;
    animation: heroShine 6s ease-in-out infinite;
  }
  @keyframes heroShine {
    0%, 100% { background-position: 0% center; }
    50%      { background-position: 100% center; }
  }
  .lede {
    font-size: 17px;
    color: var(--color-text-muted);
    max-width: 580px;
    margin-bottom: 22px;
    line-height: 1.6;
  }
  .hero-ctas {
    display: flex; gap: 12px; flex-wrap: wrap; margin-bottom: 26px;
  }

  .btn-shimmer {
    position: relative;
    overflow: hidden;
    isolation: isolate;
  }
  .btn-shimmer::before {
    content: "";
    position: absolute;
    inset: 0;
    background: linear-gradient(120deg, transparent 30%, rgba(255,255,255,0.45) 50%, transparent 70%);
    transform: translateX(-130%);
    animation: btnShimmer 3.2s ease-in-out infinite;
    pointer-events: none;
  }
  @keyframes btnShimmer {
    0%   { transform: translateX(-130%); }
    50%  { transform: translateX(130%); }
    100% { transform: translateX(130%); }
  }

  .hero-stats {
    display: grid;
    grid-template-columns: repeat(3, auto);
    gap: 32px;
  }
  .hero-stats > div { display: flex; flex-direction: column; }
  .hero-stats strong {
    font-family: var(--font-heading);
    font-size: 26px;
    font-weight: 800;
    color: var(--color-heading);
    line-height: 1;
    margin-bottom: 4px;
    letter-spacing: -0.02em;
  }
  .hero-stats span {
    font-size: 12px;
    color: var(--color-text-muted);
    letter-spacing: 0.02em;
  }

  /* ========== HERO MARQUEE (logo carousel inside hero) ========== */
  .hero-marquee {
    margin-top: 36px;
    padding-top: 24px;
    border-top: 1px solid var(--color-border);
    position: relative;
    z-index: 1;
  }
  .hero-marquee-head {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 14px;
    margin-bottom: 18px;
    text-align: center;
  }
  .hero-marquee-sub {
    color: var(--color-text-muted);
    font-size: 13px;
    font-weight: 500;
  }
  .hero-marquee-head .eyebrow { font-size: 11px; }

  .marquee {
    overflow: hidden;
    padding: 24px 0;
    mask-image: linear-gradient(90deg, transparent, #000 8%, #000 92%, transparent);
    -webkit-mask-image: linear-gradient(90deg, transparent, #000 8%, #000 92%, transparent);
  }
  .marquee-track {
    display: flex;
    gap: 16px;
    width: max-content;
    animation: marquee 38s linear infinite;
  }
  .logo-tile {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 10px;
    height: 96px;
    min-width: 180px;
    padding: 14px 28px;
    background: #fff;
    border: 1px solid var(--color-border);
    border-radius: var(--radius-md);
    flex-shrink: 0;
    transition: border-color .2s, transform .2s;
  }
  .logo-tile:hover { border-color: var(--color-accent); transform: translateY(-2px); }
  .logo-img {
    max-height: 64px;
    max-width: 160px;
    width: auto;
    height: auto;
    object-fit: contain;
  }
  @keyframes marquee {
    from { transform: translateX(0); }
    to   { transform: translateX(-50%); }
  }
  @media (prefers-reduced-motion: reduce) {
    .marquee-track { animation: none; }
  }

  /* ========== ABOUT BLURB ========== */
  .about-blurb {
    max-width: 820px;
    text-align: center;
  }
  .about-blurb h2 {
    margin: 10px 0 16px;
  }
  .about-blurb p {
    color: var(--color-text);
    font-size: 17px;
    line-height: 1.7;
    margin: 0 auto;
    max-width: 720px;
  }

  /* ========== CORE SERVICES GRID ========== */
  .core-services-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 18px;
  }
  .core-service-card {
    position: relative;
    background: #fff;
    border: 1px solid var(--color-border);
    border-radius: var(--radius-lg);
    padding: 26px 22px 22px;
    display: flex;
    flex-direction: column;
    gap: 12px;
    transition: transform .2s ease, box-shadow .2s ease, border-color .2s ease;
  }
  .core-service-card:hover {
    transform: translateY(-3px);
    box-shadow: var(--shadow-md);
    border-color: rgba(16,185,129,0.32);
  }
  .core-service-num {
    position: absolute;
    top: 18px; right: 22px;
    font-family: var(--font-heading);
    font-weight: 800;
    font-size: 38px;
    line-height: 1;
    color: rgba(212, 175, 55, 0.20);
    letter-spacing: -0.02em;
  }
  .core-service-card h3 {
    color: var(--color-heading);
    font-size: 18px;
    font-weight: 700;
    line-height: 1.3;
    padding-right: 32px;
  }
  .core-service-bullets {
    list-style: none;
    margin: 0; padding: 0;
    display: grid;
    gap: 8px;
  }
  .core-service-bullets li {
    display: flex;
    align-items: flex-start;
    gap: 8px;
    color: var(--color-text);
    font-size: 14px;
    line-height: 1.45;
  }
  .core-service-bullets li :global(svg) {
    width: 16px; height: 16px;
    flex-shrink: 0;
    margin-top: 3px;
    color: var(--color-accent-strong);
  }

  /* ========== WHY CHOOSE US (DARK) ========== */
  .why-lede {
    color: #94A3B8;
    margin-top: 12px;
    max-width: 560px;
  }
  .why-grid {
    list-style: none;
    margin: 36px 0 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 24px;
  }
  .why-item {
    display: grid;
    grid-template-columns: auto 1fr;
    gap: 14px;
    align-items: flex-start;
  }
  .feature-icon-halo {
    width: 44px; height: 44px;
    border-radius: 12px;
    background: rgba(16, 185, 129, 0.18);
    color: var(--color-accent);
    display: grid; place-items: center;
    flex-shrink: 0;
  }
  .feature-icon-halo :global(svg) { width: 20px; height: 20px; }
  .why-item h4 {
    color: #fff;
    margin-bottom: 6px;
    font-size: 16px;
  }
  .why-item p {
    color: #94A3B8;
    font-size: 13.5px;
    line-height: 1.55;
  }

  /* ========== TRUSTED BY ========== */
  .trust-logos {
    display: grid;
    grid-template-columns: repeat(6, 1fr);
    gap: 14px;
    margin: 8px 0 30px;
  }
  .trust-logo {
    display: flex;
    align-items: center;
    justify-content: center;
    height: 88px;
    background: #fff;
    border: 1px solid var(--color-border);
    border-radius: var(--radius-md);
    padding: 12px 16px;
    transition: border-color .2s ease, transform .2s ease;
  }
  .trust-logo:hover {
    border-color: var(--color-accent);
    transform: translateY(-2px);
  }
  .trust-logo img {
    max-height: 56px;
    max-width: 140px;
    width: auto; height: auto;
    object-fit: contain;
  }
  .trust-logo--abbr {
    background: linear-gradient(135deg, var(--color-primary) 0%, var(--color-primary-soft) 100%);
    border-color: var(--color-primary);
  }
  .trust-abbr {
    color: var(--color-gold);
    font-family: var(--font-heading);
    font-weight: 800;
    font-size: 18px;
    letter-spacing: 0.04em;
  }

  .recognition-row {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 14px;
    padding-top: 18px;
    border-top: 1px solid var(--color-border);
  }
  .trust-cta {
    margin-top: 28px;
    display: flex;
    justify-content: center;
  }
  .trust-cta .link-arrow {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    color: var(--color-accent-strong);
    font-weight: 600;
    font-size: 15px;
    text-decoration: none;
    transition: color .15s ease;
  }
  .trust-cta .link-arrow:hover { color: var(--color-primary); }
  .trust-cta .link-arrow :global(svg) {
    width: 16px; height: 16px;
    transition: transform .15s ease;
  }
  .trust-cta .link-arrow:hover :global(svg) { transform: translateX(2px); }
  .recognition-badge {
    display: flex;
    align-items: center;
    gap: 12px;
    padding: 10px 18px;
    background: #fff;
    border: 1px solid rgba(16, 185, 129, 0.22);
    border-radius: 999px;
    box-shadow: 0 4px 12px rgba(15, 59, 46, 0.05);
  }
  .recognition-tick {
    width: 28px; height: 28px;
    border-radius: 8px;
    background: var(--color-accent-soft);
    color: var(--color-accent-strong);
    display: grid; place-items: center;
    flex-shrink: 0;
  }
  .recognition-tick :global(svg) { width: 16px; height: 16px; }
  .recognition-badge strong {
    display: block;
    color: var(--color-heading);
    font-size: 13.5px;
    font-weight: 700;
    line-height: 1.2;
  }
  .recognition-badge span {
    display: block;
    color: var(--color-text-muted);
    font-size: 11.5px;
    margin-top: 2px;
  }

  /* ========== INDUSTRIES GRID ========== */
  .industries-grid {
    list-style: none;
    margin: 0; padding: 0;
    display: grid;
    grid-template-columns: repeat(5, 1fr);
    gap: 14px;
  }
  .industry-chip {
    display: flex;
    align-items: center;
    gap: 12px;
    padding: 18px 18px;
    background: #fff;
    border: 1px solid var(--color-border);
    border-radius: var(--radius-md);
