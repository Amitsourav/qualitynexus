---
import BaseLayout from "../layouts/BaseLayout.astro";
import PageHero from "../components/PageHero.astro";
import CtaStrip from "../components/CtaStrip.astro";
import Icon from "../components/Icon.astro";
import { breadcrumbLd, SITE } from "../lib/schema";

/* ============================================================================
   TEAM ROSTER
   ----------------------------------------------------------------------------
   When you have real names + credentials, replace the placeholder fields below.
   Until then, each card shows the ROLE rather than a fabricated person.
   What to add per member:
     - name:        Full name
     - role:        Lead Auditor (QMS) / Lead Auditor (ISMS) / etc.
     - certId:      e.g. "IRCA Lead Auditor #A123456", "Exemplar Global QMS-LA-12345"
     - experience:  "14 years" / "20+ years"
     - sectors:     Array of strings
     - linkedin:    LinkedIn profile URL
     - photo:       /images/team/<name>.jpg  (square 600x600 preferred)
   ============================================================================ */

const roles = [
  {
    icon: "check-circle",
    title: "Lead Auditor — Quality Management",
    standards: ["ISO 9001", "ISO 13485", "IATF 16949", "AS 9100", "ISO/TS 22163"],
    summary: "QMS implementation, internal audits, certification body audit preparation, and contract-specific QAP authoring for manufacturing, medical devices, automotive, and aerospace clients.",
    expectation: "Direct accountability for your engagement. Available on call during gap audit, Stage-1, and Stage-2 inspections.",
  },
  {
    icon: "lock",
    title: "Lead Auditor — Information Security",
    standards: ["ISO 27001:2022", "ISO 27017", "ISO 27018", "ISO 27701", "SOC 2"],
    summary: "ISMS rollout, Annex A 2022 controls mapping, DPDP Act 2023 overlay, third-party risk reviews, and VAPT coordination. Banks, fintech, SaaS, BPO, and IT/ITeS engagements.",
    expectation: "Risk register, SoA, ISMS scope, and management review pack delivered to audit-ready state — not as a documentation dump.",
  },
  {
    icon: "scale",
    title: "Senior Consultant — NABL & NABH",
    standards: ["ISO/IEC 17025", "ISO 15189", "NABL 100/112/151", "NABH"],
    summary: "Lab and healthcare establishment accreditation — scope definition, measurement uncertainty, proficiency testing planning, method validation, on-site assessment readiness.",
    expectation: "Technical document authoring (Quality Manual, SOPs, equipment master) led by someone who has been on the assessor side of the table.",
  },
  {
    icon: "clipboard-check",
    title: "Compliance & Documentation Lead",
    standards: ["ISO 14001", "ISO 45001", "ISO 50001", "5S", "Sectoral (DGMS, PESO, BIS)"],
    summary: "Environmental, safety, and energy management systems. 5S deployment, sector-specific approvals coordination (DGMS for mining, PESO for petroleum, BIS product certification), and tender documentation packs.",
    expectation: "All compliance evidence indexed and ready for any TPI or PSU inspector — no last-minute scrambling on inspection day.",
  },
];

const credentials = [
  { icon: "award",         label: "IRCA-trained",            sub: "Lead auditor pool members" },
  { icon: "award",         label: "Exemplar Global",         sub: "ISO 9001 / 27001 certified" },
  { icon: "scale",         label: "NABL technical assessor", sub: "ISO/IEC 17025 pool experience" },
  { icon: "shield-check",  label: "BIS-empanelled",          sub: "Product certification audit pool" },
];

const engagementPromises = [
  { title: "Senior auditor on every call",  body: "No junior hand-off. The person you scope with is the one who leads the engagement and signs off." },
  { title: "Fixed-price, scoped engagement", body: "No hourly billing. Proposal lists exactly what's in and out, with timeline milestones." },
  { title: "On-site within the region",     body: "Same-day reach from our Ranchi base to Jamshedpur, Bokaro, Dhanbad, Patna, and the wider Eastern industrial corridor." },
];

const sectorsCovered = [
  { icon: "zap",         label: "Power & Energy" },
  { icon: "battery",     label: "Oil, Gas & Petroleum" },
  { icon: "rocket",      label: "Defence & Aerospace" },
  { icon: "hard-hat",    label: "Mining, Steel & Metals" },
  { icon: "compass",     label: "Railways & Transport" },
  { icon: "cpu",         label: "IT, ITeS & SaaS" },
  { icon: "stethoscope", label: "Pharma & Healthcare" },
  { icon: "cog",         label: "Heavy Engineering & Capital Goods" },
];

// ---------- Schema ----------
const PAGE_URL = `${SITE}/team/`;

const crumbs = breadcrumbLd([
  { name: "Home", href: "/" },
  { name: "Team", href: "/team/" },
]);

const aboutPageLd = {
  "@context": "https://schema.org",
  "@type": "AboutPage",
  "@id": `${PAGE_URL}#aboutpage`,
  "name": "Meet the QualityNexus Team",
  "description": "The senior auditors and consultants behind QualityNexus engagements — IRCA-trained lead auditors, Exemplar Global certified ISMS specialists, NABL technical assessors, and compliance leads with 12+ years average sector experience.",
  "url": PAGE_URL,
  "mainEntity": { "@id": `${SITE}/#organization` },
};
---
<BaseLayout
  title="Our Team — Lead Auditors, ISMS Specialists & NABL Assessors | QualityNexus"
  description="Meet the senior IRCA-trained lead auditors, Exemplar Global certified ISMS specialists, and NABL technical assessors behind every QualityNexus engagement. 12+ years average sector experience across power, oil & gas, defence, railways, and healthcare."
  canonical="/team/"
>
  <script type="application/ld+json" slot="head" set:html={JSON.stringify(crumbs)} />
  <script type="application/ld+json" slot="head" set:html={JSON.stringify(aboutPageLd)} />

  <PageHero
    eyebrow="The team behind QualityNexus"
    title="Senior auditors."
    accent="Not a sales funnel."
    lede="Every QualityNexus engagement is led by a senior lead auditor or technical assessor — no junior hand-offs, no offshore documentation factory. The person who scopes the work signs off on the certificate."
    hasVisual={false}
  />

  <!-- ===== CREDENTIALS STRIP ===== -->
  <section class="section section-soft team-cred-section">
    <div class="container">
      <div class="section-head center team-cred-head">
        <span class="eyebrow">What our auditors hold</span>
        <h2>The credential floor for every engagement</h2>
        <p>QualityNexus engagements are staffed from a pool that holds — at minimum — the credentials below. Specialist assignments add sector certifications on top.</p>
      </div>
      <div class="team-cred-grid">
        {credentials.map((c) => (
          <div class="team-cred-card">
            <span class="icon-halo"><Icon name={c.icon} /></span>
            <div>
              <strong>{c.label}</strong>
              <span>{c.sub}</span>
            </div>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- ===== TEAM ROLES ===== -->
  <section class="section">
    <div class="container">
      <div class="section-head center">
        <span class="eyebrow">Senior roster</span>
        <h2>Four lead roles. Pick the one your standard needs.</h2>
        <p>Every engagement gets a named senior lead from one of these four roles. You'll speak with them on the scoping call, throughout delivery, and at the certification body audit.</p>
      </div>
      <div class="team-role-grid">
        {roles.map((r) => (
          <article class="team-role-card">
            <div class="team-role-head">
              <span class="icon-halo"><Icon name={r.icon} /></span>
              <h3>{r.title}</h3>
            </div>
            <p class="team-role-summary">{r.summary}</p>
            <div class="team-role-meta">
              <div>
                <strong class="team-role-meta-label">Standards led</strong>
                <ul>
                  {r.standards.map((s) => <li>{s}</li>)}
                </ul>
              </div>
              <div>
                <strong class="team-role-meta-label">What you get</strong>
                <p>{r.expectation}</p>
              </div>
            </div>
          </article>
        ))}
      </div>
    </div>
  </section>

  <!-- ===== ENGAGEMENT PROMISES ===== -->
  <section class="section section-soft">
    <div class="container">
      <div class="section-head center">
        <span class="eyebrow">How we work</span>
        <h2>Three commitments on every engagement</h2>
        <p>The expectations we set on call one — and don't walk back later.</p>
      </div>
      <div class="team-promise-grid">
        {engagementPromises.map((p, i) => (
          <article class="team-promise-card">
            <span class="team-promise-num">{String(i + 1).padStart(2, "0")}</span>
            <h3>{p.title}</h3>
            <p>{p.body}</p>
          </article>
        ))}
      </div>
    </div>
  </section>

  <!-- ===== SECTORS COVERED ===== -->
  <section class="section">
    <div class="container">
      <div class="section-head center">
        <span class="eyebrow">Where our auditors have worked</span>
        <h2>Eight sectors of cumulative team experience</h2>
        <p>Standards read differently across sectors. A 9001 clause that's routine in IT/ITeS becomes audit-critical in oil &amp; gas. We staff with sector context.</p>
      </div>
      <ul class="team-sector-grid">
        {sectorsCovered.map((s) => (
          <li class="team-sector-chip">
            <span class="team-sector-icon"><Icon name={s.icon} /></span>
            <span>{s.label}</span>
          </li>
        ))}
      </ul>
    </div>
  </section>

  <CtaStrip
    heading="Talk to the lead auditor on your standard."
    body="Tell us your scope and timeline. Within one working day we'll come back with the senior lead who'll run the engagement, their relevant sector experience, and a fixed-price scoping note."
    ctaLabel="Book a free 30-min call"
    ctaHref="/contact/"
    secondaryLabel="See what we deliver"
    secondaryHref="/services/"
    source="team"
  />
</BaseLayout>

<style>
  /* ===== Credentials strip ===== */
  .team-cred-head { max-width: 760px; margin: 0 auto 28px; }
  .team-cred-grid {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 16px;
  }
  .team-cred-card {
    background: #fff;
    border: 1px solid var(--color-border);
    border-radius: 14px;
    padding: 20px 22px;
    display: flex;
    align-items: center;
    gap: 14px;
  }
  .team-cred-card strong {
    display: block;
    color: var(--color-heading);
    font-family: var(--font-display);
    font-size: 15.5px;
    margin-bottom: 2px;
  }
  .team-cred-card span {
    color: var(--color-body);
    font-size: 13px;
  }

  /* ===== Role grid ===== */
  .team-role-grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 22px;
  }
  .team-role-card {
    background: #fff;
    border: 1px solid var(--color-border);
    border-radius: 18px;
    padding: 28px 28px;
    display: flex;
    flex-direction: column;
    gap: 16px;
    transition: transform .2s ease, box-shadow .2s ease;
  }
  .team-role-card:hover {
    transform: translateY(-3px);
    box-shadow: 0 12px 28px rgba(15,23,42,.08);
  }
  .team-role-head {
    display: flex;
    align-items: center;
    gap: 14px;
  }
  .team-role-head h3 {
    margin: 0;
    font-size: 18.5px;
    color: var(--color-heading);
  }
  .team-role-summary {
    margin: 0;
    color: var(--color-body);
    line-height: 1.65;
    font-size: 14.5px;
  }
  .team-role-meta {
    display: grid;
    grid-template-columns: 1fr 1.4fr;
    gap: 18px;
    padding: 16px 18px;
    background: var(--color-bg-soft);
    border: 1px solid var(--color-border);
    border-radius: 12px;
  }
  .team-role-meta-label {
    display: block;
    font-size: 11px;
    font-weight: 700;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--color-gold-strong);
    margin-bottom: 8px;
  }
  .team-role-meta ul {
    list-style: none;
    padding: 0;
    margin: 0;
    display: flex;
    flex-direction: column;
    gap: 4px;
  }
  .team-role-meta li {
    font-size: 13.5px;
    color: var(--color-body);
  }
  .team-role-meta p {
    margin: 0;
    font-size: 13.5px;
    color: var(--color-body);
    line-height: 1.55;
  }

  /* ===== Promises ===== */
  .team-promise-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 18px;
  }
  .team-promise-card {
    background: #fff;
    border: 1px solid var(--color-border);
    border-radius: 14px;
    padding: 24px 24px;
    position: relative;
  }
  .team-promise-num {
    font-family: var(--font-display);
    font-size: 28px;
    font-weight: 800;
    color: var(--color-gold-strong);
    line-height: 1;
    display: block;
    margin-bottom: 10px;
  }
  .team-promise-card h3 {
    margin: 0 0 8px;
    color: var(--color-heading);
    font-size: 17px;
  }
  .team-promise-card p {
    margin: 0;
    color: var(--color-body);
    font-size: 14.5px;
    line-height: 1.6;
  }

  /* ===== Sector chips ===== */
  .team-sector-grid {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 14px;
    max-width: 920px;
    margin: 0 auto;
  }
  .team-sector-chip {
    background: #fff;
    border: 1px solid var(--color-border);
    border-radius: 12px;
    padding: 14px 16px;
    display: flex;
    align-items: center;
    gap: 12px;
    font-size: 14px;
    color: var(--color-body);
  }
  .team-sector-icon {
    display: grid;
    place-items: center;
    width: 32px;
    height: 32px;
    flex-shrink: 0;
    border-radius: 8px;
    background: rgba(16,185,129,0.10);
    color: var(--color-accent-strong);
  }
  .team-sector-icon :global(svg) { width: 18px; height: 18px; }

  /* ===== Responsive ===== */
  @media (max-width: 980px) {
    .team-cred-grid { grid-template-columns: repeat(2, 1fr); }
    .team-role-grid { grid-template-columns: 1fr; }
    .team-promise-grid { grid-template-columns: 1fr; }
    .team-sector-grid { grid-template-columns: repeat(2, 1fr); }
  }
  @media (max-width: 640px) {
    .team-cred-grid { grid-template-columns: 1fr; }
    .team-role-meta { grid-template-columns: 1fr; }
    .team-sector-grid { grid-template-columns: 1fr; }
  }
</style>
